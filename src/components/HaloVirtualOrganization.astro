<section data-organization hidden>
  <h2>Virtual organization</h2>
  <p>Directors own goals. Specialists prepare work. Gordon reviews exceptions and decisions.</p>
  <p data-org-status role="status" aria-live="polite"></p>
  <div class="org-controls" data-org-controls></div>
  <button type="button" data-org-run>Run all approved work</button>
  <button type="button" data-org-refresh>Refresh operating state</button>
  <h3>What should we do today?</h3>
  <div data-org-priorities></div>
  <details>
    <summary>Add a launch goal</summary>
    <form data-org-goal>
      <label>Outcome <input name="title" required maxlength="160" /></label>
      <label>Accountable agent <select name="agent_id" data-org-agent-select required></select></label>
      <label>Target <input name="target" type="number" min="0.01" step="any" required /></label>
      <label>Unit <input name="unit" required maxlength="80" placeholder="active Hosts" /></label>
      <label>Deadline <input name="deadline" type="date" required /></label>
      <button type="submit">Save goal</button>
    </form>
  </details>
  <h3>Needs Gordon</h3>
  <div data-org-approvals></div>
  <h3>Agent directory</h3>
  <div data-org-agents></div>
  <h3>Work contracts and results</h3>
  <p>Latest 100 work contracts</p>
  <div data-org-tasks></div>
  <h3>Decision Registry</h3>
  <form data-org-decision>
    <label>Question <input name="question" required maxlength="500" /></label>
    <label>Decision <textarea name="answer" required maxlength="4000"></textarea></label>
    <label>Scope <input name="scope" required maxlength="200" /></label>
    <label>Reason <input name="reason" required maxlength="1000" /></label>
    <label>Expires <input name="expires_at" type="datetime-local" /></label>
    <button type="submit">Record decision</button>
  </form>
  <div data-org-decisions></div>
  <h3>Canonical HALO Source</h3>
  <form data-org-canonical_asset>
    <label>Asset title <input name="title" required maxlength="200" /></label>
    <label>Version <input name="version" required maxlength="80" /></label>
    <label>Content or approved asset reference <textarea name="content" required></textarea></label>
    <label>Status <select name="status"><option>draft</option><option>review</option><option>current</option><option>retired</option></select></label>
    <label>Approval evidence <input name="evidence" /></label>
    <button type="submit">Record canonical asset version</button>
  </form>
  <div data-org-assets></div>
  <h3>Audit trail</h3>
  <div data-org-audit></div>
</section>
<style>
  [data-organization]{margin-top:2rem}
  [data-organization] :global(h2),[data-organization] :global(h3),[data-organization] :global(h4){color:inherit}
  [data-organization] :global(article),[data-organization] :global(details){border:1px solid #3b3d48;border-radius:8px;margin:1rem 0;padding:1rem;overflow-wrap:anywhere}
  [data-organization] :global(form){display:grid;gap:.65rem;margin:1rem 0;max-width:660px}
  [data-organization] :global(label){display:grid;gap:.25rem}
  [data-organization] :global(input),[data-organization] :global(select),[data-organization] :global(textarea){font:inherit;padding:.5rem;max-width:100%;min-width:0}
  [data-organization] :global(button){font:inherit;padding:.5rem .7rem;margin:.25rem;cursor:pointer}
  [data-organization] :global(summary){cursor:pointer;font-weight:700}
  [data-organization] :global(pre){white-space:pre-wrap;overflow-wrap:anywhere;font-size:.85rem}
  .org-controls{display:flex;flex-wrap:wrap;gap:.5rem}
</style>
<script>
  import { supabase } from '../scripts/halo-account';
  const client = supabase;
  const root = document.querySelector<HTMLElement>('[data-organization]')!;
  const status = root.querySelector<HTMLElement>('[data-org-status]')!;
  const target = (name: string) => root.querySelector<HTMLElement>(`[data-org-${name}]`)!;
  let generation = 0;
  let busy = false;
  let loadSequence = 0;

  type Agent = { id: string; name: string; director_id: string | null; mission: string; autonomy: number; enabled: boolean; paused: boolean };
  type Goal = { id: string; title: string; agent_id: string; target: number; current_value: number | null; forecast: number | null; deadline: string; unit: string; evidence: string | null; observed_at: string | null };
  type Workflow = { id: string; agent_id: string; title: string; executor: string; enabled: boolean; allowed_tools: string[]; steps: string[] };
  type Task = { id: string; agent_id: string; objective: string; state: string; deadline: string; expected_output: string; success_metric: string; fallback: string; evidence_required: string; allowed_tools: string[]; result: unknown; evidence: string | null; learning: string | null };
  type Approval = { id: string; task_id: string; decision: string; recommendation: string; reason: string; risk: string; cost: number; expires_at: string; status: string };

  function element(tag: string, text = '') {
    const node = document.createElement(tag);
    node.textContent = text;
    return node;
  }

  function button(label: string, action: () => void) {
    const node = document.createElement('button');
    node.type = 'button';
    node.textContent = label;
    node.addEventListener('click', () => { if (!busy) action(); });
    return node;
  }

  function input(form: HTMLFormElement, name: string, label: string, value = '', type = 'text', required = true) {
    const wrapper = element('label', label);
    const field = document.createElement('input');
    field.name = name;
    field.type = type;
    field.value = value;
    field.required = required;
    wrapper.append(field);
    form.append(wrapper);
    return field;
  }

  function formAction(form: HTMLFormElement, label: string, action: (fields: Record<string, string>) => Promise<void>) {
    const submit = document.createElement('button');
    submit.type = 'submit';
    submit.textContent = label;
    form.append(submit);
    form.addEventListener('submit', event => {
      event.preventDefault();
      if (busy) return;
      const fields = Object.fromEntries(new FormData(form)) as Record<string, string>;
      void action(fields);
    });
  }

  async function command(name: string, payload: object = {}) {
    await request('halo_operating_command', { command: name, payload });
  }

  async function request(rpc: string, args: object = {}) {
    if (!client || busy || root.hidden) return;
    const view = generation;
    busy = true;
    root.querySelectorAll<HTMLButtonElement>('button').forEach(node => { node.disabled = true; });
    status.textContent = 'Saving operating state…';
    try {
      const { data, error } = await client.rpc(rpc, args);
      if (view !== generation) return;
      if (error) throw error;
      await load(view);
      if (view !== generation) return;
      status.textContent = rpc === 'halo_run_approved_work'
        ? `${data.preview ? 'Preview' : 'Run'} · ${data.eligible} eligible · ${data.completed} internal briefs completed · ${data.waiting} waiting on approval or tool`
        : 'Operating state saved.';
    } catch (error) {
      if (view === generation) status.textContent = error instanceof Error ? error.message : 'Could not save. Refresh and check the operating state.';
    } finally {
      if (view === generation) {
        busy = false;
        root.querySelectorAll<HTMLButtonElement>('button').forEach(node => { node.disabled = false; });
      }
    }
  }

  function prepare(agent: Agent, goal?: Goal) {
    const deadline = goal ? `${goal.deadline}T23:59:59Z` : new Date(Date.now() + 86400000).toISOString();
    void command('task', {
      agent_id: agent.id, workflow_id: agent.id + '-brief', goal_id: goal?.id ?? null,
      objective: goal ? `Prepare the next intervention for ${goal.title}` : `Prepare the ${agent.name} operating brief`,
      deadline, inputs: { source: 'mission_control', goal_id: goal?.id ?? null },
      expected_output: 'A work package containing current goals, decisions, canonical assets and the next intervention.',
      success_metric: 'A traceable brief supports the next launch decision.',
      fallback: 'Escalate missing inputs or conflicting decisions to the Gordon Liaison.',
      evidence_required: 'Persisted workflow run with source decisions and canonical asset versions.',
    });
  }

  async function load(view: number) {
    const sequence = ++loadSequence;
    const tables = ['halo_operating_controls','halo_agents','halo_goals','halo_agent_workflows',
      'halo_agent_tasks','halo_agent_approvals','halo_decisions','halo_agent_audit','halo_canonical_assets'];
    const results = await Promise.all(tables.map(table => {
      const query = client!.from(table).select('*');
      return ['halo_agent_tasks','halo_agent_approvals','halo_decisions','halo_agent_audit'].includes(table)
        ? query.order(table === 'halo_agent_approvals' ? 'requested_at' : 'created_at', { ascending: false }).limit(100)
        : query;
    }));
    if (view !== generation || sequence !== loadSequence) return;
    if (results.some(result => result.error)) {
      status.textContent = 'Virtual organization unavailable. Check that its database migration has been applied and staff access is assigned.';
      return;
    }
    const [controlRows, agents, goals, workflows, tasks, approvals, decisions, audit, assets] = results.map(result => result.data!);
    const controls = controlRows[0];
    if (!controls) { status.textContent = 'Operating controls have not been installed.'; return; }
    const agentList = agents as Agent[];
    const names = new Map(agentList.map(agent => [agent.id, agent.name]));
    const controlsView = target('controls');
    controlsView.replaceChildren();
    for (const [key, label] of [['paused','All autonomous work'],['preview','Preview mode'],['external_paused','External sends paused'],['spend_paused','Spend paused']]) {
      controlsView.append(button(`${label} · ${controls[key] ? 'ON' : 'OFF'}`, () => void command('controls', { [key]: !controls[key] })));
    }

    const select = root.querySelector<HTMLSelectElement>('[data-org-agent-select]')!;
    const selected = select.value;
    select.replaceChildren();
    agentList.forEach(agent => {
      const option = document.createElement('option');
      option.value = agent.id;
      option.textContent = agent.name;
      select.append(option);
    });
    if (selected) select.value = selected;

    const priorities = target('priorities');
    priorities.replaceChildren();
    if (!goals.length) priorities.append(element('p','No quantified goals recorded. Add launch targets and dated observations to generate a grounded operating plan.'));
    const ranked = (goals as Goal[]).slice().sort((a,b) => a.deadline.localeCompare(b.deadline));
    for (const goal of ranked) {
      const card = element('article');
      const gap = goal.forecast === null ? 'Unavailable' : String(Math.max(0,goal.target - goal.forecast));
      const days = Math.max(1,Math.ceil((Date.parse(goal.deadline + 'T23:59:59Z') - Date.now()) / 86400000));
      const pace = goal.current_value === null ? 'Unavailable' : `${(Math.max(0,goal.target - goal.current_value) / days).toFixed(2)} ${goal.unit}/day`;
      card.append(element('h4',goal.title), element('p',`Owner ${names.get(goal.agent_id)} · Deadline ${goal.deadline}`),
        element('p',`Current ${goal.current_value ?? 'Unavailable'} · Target ${goal.target} ${goal.unit} · Forecast ${goal.forecast ?? 'Unavailable'} · Forecast gap ${gap}`),
        element('p',`Required pace ${pace}`),element('p',goal.observed_at ? `Observed ${new Date(goal.observed_at).toLocaleString()} · ${goal.evidence}` : 'Observation evidence unavailable.'));
      const agent = agentList.find(entry => entry.id === goal.agent_id)!;
      const pending = (tasks as Task[]).some(task => (task as Task & {goal_id: string}).goal_id === goal.id && !['cancelled','measured','failed'].includes(task.state));
      card.append(element('p', pending ? 'An intervention is already in progress.' : goal.current_value === null ? 'Next intervention · establish a verified baseline.' : 'Next intervention · prepare a gap-closing work package.'));
      if (!pending) card.append(button('Prepare intervention', () => prepare(agent,goal)));
      const metricForm = document.createElement('form');
      input(metricForm,'current_value','Observed current',String(goal.current_value ?? ''),'number').min = '0';
      input(metricForm,'forecast','Evidence-based forecast',String(goal.forecast ?? ''),'number',false).min = '0';
      input(metricForm,'evidence','Observation and forecast evidence',goal.evidence ?? '');
      metricForm.querySelectorAll('input[type="number"]').forEach(field => field.setAttribute('step','any'));
      formAction(metricForm,'Record observation', fields => command('metric',{id:goal.id,...fields,forecast:fields.forecast || null}));
      card.append(metricForm);
      priorities.append(card);
    }

    const approvalsView = target('approvals');
    approvalsView.replaceChildren();
    const pending = (approvals as Approval[]).filter(approval => approval.status === 'pending');
    if (!pending.length) approvalsView.append(element('p','No pending approval requests in the latest 100 records.'));
    for (const approval of pending) {
      const card = element('article');
      card.append(element('h4',approval.decision),element('p',`${approval.recommendation} · ${approval.reason}`),
        element('p',`Risk ${approval.risk} · Cost ${approval.cost} · Expires ${new Date(approval.expires_at).toLocaleString()}`));
      if (Date.parse(approval.expires_at) <= Date.now()) card.append(element('p','Expired. Create a fresh work contract for review.'));
      else {
        const form = document.createElement('form');
        input(form,'response','Decision or correction');
        const label = element('label','Response');
        const select = document.createElement('select');
        select.name = 'status';
        for (const state of ['approved','modified','declined']) {
          const option = document.createElement('option'); option.value = state; option.textContent = state; select.append(option);
        }
        label.append(select); form.append(label);
        formAction(form,'Record authenticated decision',fields => command('approval',{id:approval.id,...fields}));
        card.append(form);
      }
      approvalsView.append(card);
    }

    const directory = target('agents');
    directory.replaceChildren();
    for (const agent of agentList.sort((a,b) => a.name.localeCompare(b.name))) {
      const page = element('details');
      page.id = 'agent-' + agent.id;
      page.append(element('summary',`${agent.name} · ${agent.paused ? 'Paused' : agent.enabled ? 'Enabled' : 'Registry only'}`),
        element('p',agent.mission),element('p',`Reports to ${agent.director_id ? names.get(agent.director_id) : 'Gordon'} · Autonomy ${agent.autonomy}`));
      page.append(button(agent.paused ? 'Resume agent' : 'Pause agent',() => void command('agent',{id:agent.id,paused:!agent.paused})),
        button(agent.enabled ? 'Disable agent' : 'Enable internal workflows',() => void command('agent',{id:agent.id,enabled:!agent.enabled})),
        button('Prepare operating brief',() => prepare(agent)));
      for (const workflow of (workflows as Workflow[]).filter(flow => flow.agent_id === agent.id)) {
        page.append(element('h4',workflow.title),element('p',workflow.enabled ? 'Internal executor available' : 'Awaiting tool gateway adapter and approved policy'),
          element('p',workflow.steps.join(' → ')),element('p','Tools · ' + workflow.allowed_tools.join(', ')));
      }
      page.append(element('p','External tool adapters and channel pipelines require connection before external execution.'));
      directory.append(page);
    }

    const work = target('tasks');
    work.replaceChildren();
    if (!tasks.length) work.append(element('p','No work contracts yet. Prepare an intervention or an agent brief.'));
    for (const task of tasks as Task[]) {
      const card = element('details');
      card.append(element('summary',`${task.objective} · ${task.state}`),element('p',`Owner ${names.get(task.agent_id)} · Deadline ${new Date(task.deadline).toLocaleString()}`),
        element('p','Expected output · ' + task.expected_output),element('p','Success metric · ' + task.success_metric),
        element('p','Fallback · ' + task.fallback),element('p','Required evidence · ' + task.evidence_required));
      if (task.evidence) card.append(element('p','Evidence · ' + task.evidence));
      if (task.result) card.append(element('pre',JSON.stringify(task.result,null,2)));
      if (task.learning) card.append(element('p','Learning · ' + task.learning));
      if (task.state === 'queued') card.append(button('Pause task',() => void command('task_state',{id:task.id,state:'paused'})));
      if (task.state === 'paused') card.append(button('Resume task',() => void command('task_state',{id:task.id,state:'queued'})));
      if (['planned','waiting_on_gordon','blocked','waiting_on_tool'].includes(task.state)) {
        const form = document.createElement('form');
        input(form,'objective','Revised objective',task.objective).maxLength = 2000;
        formAction(form,'Revise and request fresh approval',fields => command('replan',{id:task.id,...fields}));
        card.append(form);
      }
      if (!['completed','verified','measured','running','cancelled'].includes(task.state)) {
        card.append(button('Cancel work contract',() => void command('task_state',{id:task.id,state:'cancelled'})));
      }
      if (['completed','verified'].includes(task.state)) {
        const form = document.createElement('form');
        const verify = task.state === 'completed';
        input(form,verify ? 'evidence' : 'learning',verify ? 'Independent verification evidence' : 'Measured result and learning');
        formAction(form,verify ? 'Record verification' : 'Record measurement',fields => command('task_state',{id:task.id,state:verify ? 'verified' : 'measured',...fields}));
        card.append(form);
      }
      work.append(card);
    }

    const registry = target('decisions');
    registry.replaceChildren();
    for (const decision of decisions) registry.append(element('p',`${decision.question} · ${decision.answer} · Scope ${decision.scope} · ${decision.expires_at ? 'Expires ' + new Date(decision.expires_at).toLocaleString() : 'No expiry'}`));
    const assetList = target('assets');
    assetList.replaceChildren();
    for (const asset of assets) assetList.append(element('p',`${asset.title} · ${asset.version} · ${asset.status}`));
    const log = target('audit');
    log.replaceChildren();
    log.append(element('p','Latest 100 audit events'));
    for (const event of audit) log.append(element('p',`${new Date(event.created_at).toLocaleString()} · ${event.event} · ${event.object_id}`));
    status.textContent = 'Operating state loaded. Briefs are deterministic internal work packages. AI judgment and external execution require connected runtime adapters.';
  }

  target('run').addEventListener('click',() => void request('halo_run_approved_work'));
  target('refresh').addEventListener('click',() => { if (!busy) void load(generation); });
  for (const [name,commandName] of [['goal','goal'],['decision','decision'],['canonical_asset','canonical_asset']]) {
    const form = root.querySelector<HTMLFormElement>(`[data-org-${name}]`)!;
    form.addEventListener('submit',event => {
      event.preventDefault();
      const fields = Object.fromEntries(new FormData(form)) as Record<string,string | null>;
      if (commandName === 'decision') fields.expires_at = fields.expires_at ? new Date(fields.expires_at).toISOString() : null;
      void command(commandName,fields);
    });
  }

  client?.auth.onAuthStateChange((_event,session) => {
    const view = ++generation;
    busy = false;
    root.hidden = true;
    root.querySelectorAll<HTMLButtonElement>('button').forEach(node => { node.disabled = false; });
    for (const name of ['controls','priorities','approvals','agents','tasks','decisions','assets','audit']) target(name).replaceChildren();
    root.querySelectorAll<HTMLFormElement>('form').forEach(form => form.reset());
    if (session) window.setTimeout(async () => {
      const { data,error } = await client.from('halo_launch_staff').select('user_id').maybeSingle();
      if (view !== generation || error || !data) return;
      root.hidden = false;
      await load(view);
    },0);
  });
</script>
