<section class="marketing" aria-labelledby="marketing-title">
  <h2 id="marketing-title">Marketing Command Center</h2>
  <p data-marketing-status role="status">Sign in with a HALO launch staff account.</p>
  <div data-marketing-board hidden>
    <h3>Launch readiness</h3>
    <p data-marketing-readiness></p>
    <h3>Next actions</h3>
    <ol data-marketing-next></ol>
    <h3>Marketing runner</h3>
    <p data-marketing-runner-status role="status"></p>
    <div data-marketing-runner-controls></div>
    <h3>Needs your input</h3>
    <div data-marketing-inbox></div>
    <h3>Drafts for review</h3>
    <div data-marketing-drafts></div>
    <h3>Campaigns</h3>
    <div data-marketing-campaigns></div>
    <h3>Activity planner</h3>
    <p>Expected ROI is an initial planning estimate. Indirect activities enable other work. Actual results are tracked independently.</p>
    <label>Campaign <select data-marketing-filter><option value="">All campaigns</option></select></label>
    <div data-marketing-activities></div>
  </div>
</section>

<style>
  .marketing{margin:1.5rem 0;padding:1rem;border:1px solid #3b3d48;border-radius:8px}
  .marketing :is(h2,h3){color:inherit}
  .marketing :global(details){border-top:1px solid #3b3d48;padding:.75rem 0}
  .marketing :global(summary){cursor:pointer;font-weight:700;overflow-wrap:anywhere}
  .marketing :global(form){display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,12rem),1fr));gap:.65rem}
  .marketing :global(label){display:grid;gap:.25rem;min-width:0}
  .marketing :global(input),.marketing :global(select),.marketing :global(textarea),.marketing :global(button){
    font:inherit;color:#f1f1f5;background:#24252d;border:1px solid #5d5f70;border-radius:5px;padding:.35rem .5rem;min-width:0
  }
  .marketing :global(button){align-self:end;cursor:pointer}
  .marketing :global(form p){grid-column:1/-1;margin:0}
  .marketing :global(.run-draft){white-space:pre-wrap;overflow-wrap:anywhere}
  [data-marketing-runner-controls]{display:flex;flex-wrap:wrap;gap:.5rem}
</style>

<script>
  import { supabase } from '../scripts/halo-account';
  import { rankActivities } from '../scripts/halo-marketing-priority.mjs';

  const status = document.querySelector<HTMLElement>('[data-marketing-status]')!;
  const board = document.querySelector<HTMLElement>('[data-marketing-board]')!;
  const readiness = document.querySelector<HTMLElement>('[data-marketing-readiness]')!;
  const next = document.querySelector<HTMLOListElement>('[data-marketing-next]')!;
  const campaigns = document.querySelector<HTMLElement>('[data-marketing-campaigns]')!;
  const activities = document.querySelector<HTMLElement>('[data-marketing-activities]')!;
  const filter = document.querySelector<HTMLSelectElement>('[data-marketing-filter]')!;
  const client = supabase;
  const runnerStatus = document.querySelector<HTMLElement>('[data-marketing-runner-status]')!;
  const runnerControls = document.querySelector<HTMLElement>('[data-marketing-runner-controls]')!;
  const inbox = document.querySelector<HTMLElement>('[data-marketing-inbox]')!;
  const drafts = document.querySelector<HTMLElement>('[data-marketing-drafts]')!;
  let generation = 0;
  let loadSequence = 0;
  let runnerSequence = 0;
  let runnerAvailable = false;
  let runnerBusy = false;
  let selectedRun: number | null = null;
  let runnerVersion = '';
  let titles = new Map<number, string>();

  function runnerButton(label: string, action: () => void) {
    const button = document.createElement('button');
    button.type = 'button';
    button.textContent = label;
    button.addEventListener('click', action);
    return button;
  }

  async function command(view: number, action: string, id: number | null = null, input: string | null = null) {
    if (!client || view !== generation || runnerBusy) return;
    runnerBusy = true;
    runnerStatus.textContent = 'Working…';
    try {
      const { data, error } = await client.rpc('halo_marketing_runner_command', {
        p_command: action, p_activity: id, p_input: input,
      });
      if (view !== generation) return;
      if (error) {
        runnerStatus.textContent = error.code === '22023' ? error.message : 'Could not run this command. Refresh and try again.';
        return;
      }
      selectedRun = action === 'run' ? (data ?? id) : null;
      runnerVersion = '';
      await loadRunner(view);
      if (view !== generation) return;
      if (selectedRun !== null) {
        const result = board.querySelector<HTMLElement>('[data-run-id="' + selectedRun + '"]');
        if (result instanceof HTMLDetailsElement) result.open = true;
        result?.scrollIntoView({ block: 'nearest' });
        result?.querySelector('summary')?.focus();
      }
    } catch {
      if (view === generation) runnerStatus.textContent = 'Could not confirm the command. Refresh to check the result.';
    } finally {
      runnerBusy = false;
    }
  }

  async function loadRunner(view: number) {
    if (!client || view !== generation) return;
    const request = ++runnerSequence;
    const [settings, runs] = await Promise.all([
      client.from('halo_marketing_runner_settings').select('enabled').maybeSingle(),
      client.from('halo_marketing_runs').select('activity_id,state,prompt,draft,operator_input,updated_at').order('created_at').order('activity_id'),
    ]);
    if (view !== generation || request !== runnerSequence) return;
    runnerAvailable = !settings.error && !runs.error && !!settings.data;
    for (const button of board.querySelectorAll<HTMLButtonElement>('[data-run-activity]')) {
      button.disabled = !runnerAvailable;
    }
    if (!runnerAvailable) {
      runnerStatus.textContent = 'The marketing runner is unavailable. Check the database migration and refresh.';
      return;
    }
    const version = JSON.stringify([settings.data, runs.data, [...titles]]);
    if (version === runnerVersion) return;
    runnerVersion = version;
    const enabled = !!settings.data?.enabled;
    runnerStatus.textContent = enabled ? 'Automatic queue on' : 'Automatic queue paused';
    runnerControls.replaceChildren(
      runnerButton(enabled ? 'Pause automatic queue' : 'Start automatic queue', () => void command(view, enabled ? 'pause' : 'start')),
      runnerButton('Refresh runner', () => void loadRunner(view)),
    );
    const replies = new Map([...inbox.querySelectorAll<HTMLTextAreaElement>('textarea')].map(
      input => [input.name, input.value],
    ));
    const open = new Set([...board.querySelectorAll<HTMLDetailsElement>('[data-run-id][open]')].map(
      item => item.dataset.runId,
    ));
    inbox.replaceChildren();
    drafts.replaceChildren();
    for (const row of runs.data ?? []) {
      const title = titles.get(row.activity_id) || 'Activity #' + row.activity_id;
      const draft = paragraph(row.draft);
      draft.className = 'run-draft';
      const item = detail(row.state === 'needs_input' ? title + ' — ' + row.prompt : title, draft);
      item.dataset.runId = String(row.activity_id);
      item.open = selectedRun === row.activity_id || open.has(item.dataset.runId);
      if (row.state === 'needs_input') {
        const form = document.createElement('form');
        const label = document.createElement('label');
        label.textContent = row.prompt;
        const input = document.createElement('textarea');
        input.name = String(row.activity_id);
        input.required = true;
        input.maxLength = 4000;
        input.value = replies.get(input.name) || '';
        const submit = document.createElement('button');
        submit.textContent = 'Submit input';
        label.append(input);
        form.append(label, submit);
        form.addEventListener('submit', event => {
          event.preventDefault();
          if (input.value.trim()) void command(view, 'answer', row.activity_id, input.value);
        });
        item.append(form);
        inbox.append(item);
      } else {
        item.append(paragraph('Operator input'), paragraph(row.operator_input || ''));
        drafts.append(item);
      }
    }
    if (!inbox.childElementCount) inbox.append(paragraph('No input requested.'));
    if (!drafts.childElementCount) drafts.append(paragraph('No drafts for review.'));
  }

  function runActivity(view: number, id: number) {
    const button = runnerButton('Run autonomously', () => void command(view, 'run', id));
    button.dataset.runActivity = '';
    button.disabled = !runnerAvailable;
    return button;
  }

  function paragraph(value: string) {
    const node = document.createElement('p');
    node.textContent = value;
    return node;
  }

  type Field = [key: string, label: string, kind?: 'number' | 'date' | 'textarea' | string[], min?: number, max?: number];
  type EditableRow = { id: string | number; [key: string]: unknown };

  function editor(table: string, row: EditableRow, fields: Field[], view: number) {
    const form = document.createElement('form');
    for (const [key, title, kind, min, max] of fields) {
      const label = document.createElement('label');
      label.textContent = title;
      const input = Array.isArray(kind) ? document.createElement('select') :
        kind === 'textarea' ? document.createElement('textarea') : document.createElement('input');
      if (input instanceof HTMLSelectElement && Array.isArray(kind)) {
        for (const option of kind) input.add(new Option(option, option));
      }
      if (input instanceof HTMLInputElement) {
        input.type = typeof kind === 'string' ? kind : 'text';
        if (min != null) input.min = String(min);
        if (max != null) input.max = String(max);
        if (key === 'budget_usd') input.step = '0.01';
      }
      input.required = !['budget_usd', 'book_target', 'activation_target', 'outcome'].includes(key);
      input.name = key;
      input.value = String(row[key] ?? '');
      label.append(input);
      form.append(label);
    }
    const button = document.createElement('button');
    button.textContent = 'Save plan';
    const feedback = paragraph('');
    feedback.setAttribute('role', 'status');
    form.append(button, feedback);
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!client || view !== generation) return;
      const formData = new FormData(form);
      const changes: Record<string, string | number | null> = {};
      for (const [key, , kind] of fields) {
        const value = String(formData.get(key) ?? '').trim();
        changes[key] = value ? kind === 'number' ? Number(value) : value : null;
      }
      if (changes.status === 'Completed' && !changes.outcome) {
        feedback.textContent = 'Enter the outcome before marking this activity complete.';
        return;
      }
      button.disabled = true;
      feedback.textContent = 'Saving…';
      try {
        const { error, data } = await client.from(table).update(changes).eq('id', row.id).select('id').single();
        if (view !== generation) return;
        if (error || !data) feedback.textContent = 'Save failed. Check the fields and your staff access, then retry.';
        else await load(view, 'Plan saved.');
      } catch {
        if (view === generation) feedback.textContent = 'Could not confirm the save. Refresh to check the stored plan.';
      } finally {
        button.disabled = false;
      }
    });
    return form;
  }

  function detail(title: string, ...children: Node[]) {
    const element = document.createElement('details');
    const summary = document.createElement('summary');
    summary.textContent = title;
    element.append(summary, ...children);
    return element;
  }

  async function load(view: number, message = '') {
    if (!client || view !== generation) return;
    const request = ++loadSequence;
    const current = () => view === generation && request === loadSequence;
    try {
      const staff = await client.from('halo_launch_staff').select('user_id').maybeSingle();
      if (!current()) return;
      if (staff.error || !staff.data) {
        board.hidden = true;
        status.textContent = staff.error ? 'Could not verify launch staff access.' : 'Launch staff access is required.';
        return;
      }
      const [campaignResult, activityResult, milestoneResult] = await Promise.all([
        client.from('halo_marketing_campaigns').select('*').order('starts_on'),
        client.from('halo_marketing_activities').select('*').order('id'),
        client.from('halo_production_milestones').select('step,title,verified'),
      ]);
      if (!current()) return;
      if (campaignResult.error || activityResult.error || milestoneResult.error) throw new Error('Tracker unavailable');
      const selected = filter.value;
      filter.replaceChildren(new Option('All campaigns', ''));
      const names = new Map<string, string>();
      campaigns.replaceChildren();
      for (const row of campaignResult.data) {
        names.set(row.id, row.title);
        filter.add(new Option(row.title, row.id));
        campaigns.append(detail(row.title + ' · ' + row.starts_on + ' to ' + row.ends_on,
          paragraph(row.owner + ' · ' + row.goal),
          editor('halo_marketing_campaigns', row, [
            ['owner', 'Owner'], ['goal', 'Conversion goal'], ['book_target', 'Book sales target', 'number', 0],
            ['activation_target', 'First-action target', 'number', 0], ['budget_usd', 'Planned budget (USD)', 'number', 0],
          ], view)));
      }
      filter.value = names.has(selected) ? selected : '';
      const today = new Intl.DateTimeFormat('sv-SE', { timeZone: 'America/New_York' }).format(new Date());
      const ranked = rankActivities(activityResult.data, milestoneResult.data, today);
      titles = new Map(ranked.map(row => [row.id, row.title]));
      const active = ranked.filter(row => row.active);
      const blocked = active.filter(row => row.blockers.length > 0);
      const unplanned = campaignResult.data.filter(row => row.budget_usd == null ||
        row.book_target == null || row.activation_target == null);
      readiness.textContent = ranked.filter(row => row.status === 'Completed').length + ' of ' + ranked.length +
        ' complete · ' + blocked.length + ' blocked · ' + active.filter(row => row.overdue).length +
        ' overdue · ' + unplanned.length + ' campaigns missing budget or targets';
      next.replaceChildren();
      const ready = active.filter(row => !row.blockers.length);
      for (const row of ready.slice(0, 5)) {
        const entry = document.createElement('li');
        entry.textContent = row.priority + ' · ' + row.title + ' · ' + row.owner + ' · ' + row.due_on + ' — ' + row.next_action;
        entry.append(' ', runActivity(view, row.id));
        next.append(entry);
      }
      if (!next.childElementCount) {
        const entry = document.createElement('li');
        entry.textContent = 'No unblocked actions.';
        next.append(entry);
      }
      filter.onchange = renderActivities;
      renderActivities();
      board.hidden = false;
      status.textContent = message || 'Launch plan';
      void loadRunner(view);

      function renderActivities() {
        activities.replaceChildren();
        for (const row of ranked.filter(item => !filter.value || item.campaign_id === filter.value)) {
          const flags = [row.status, row.overdue ? 'Overdue' : '', row.active && row.blockers.length ? 'Blocked' : ''].filter(Boolean);
          activities.append(detail(row.priority + ' · ' + row.title + ' · ' + row.expected_roi + ' expected ROI · ' + flags.join(' · '),
            paragraph(names.get(row.campaign_id) + ' / ' + row.channel),
            paragraph('Objective — ' + row.objective),
            paragraph('Complete when — ' + row.exit_criteria),
            paragraph(row.blockers.length ? 'Dependencies — ' + row.blockers.join(', ') : 'Dependencies satisfied'),
            ...(row.active && !row.blockers.length ? [runActivity(view, row.id)] : []),
            editor('halo_marketing_activities', row, [
              ['owner', 'Owner'], ['next_action', 'Next action', 'textarea'], ['due_on', 'Due date', 'date'],
              ['expected_roi', 'Expected ROI', ['High','Medium','Low','Indirect']], ['confidence', 'Confidence (1–5)', 'number', 1, 5],
              ['urgency', 'Urgency (1–5)', 'number', 1, 5], ['impact', 'Impact (1–5)', 'number', 1, 5],
              ['effort', 'Effort (1–5)', 'number', 1, 5], ['dependency_importance', 'Dependency importance (1–5)', 'number', 1, 5],
              ['cost_band', 'Cost band', ['Low','Medium','High']], ['status', 'Status', ['Planned','Drafted','Completed','Paused']],
              ['outcome', 'Outcome or evidence link', 'textarea'],
            ], view)));
        }
      }
    } catch {
      if (!current()) return;
      board.hidden = true;
      status.textContent = 'Could not load the marketing plan. Check the database migration and refresh.';
    }
  }

  if (!client) status.textContent = 'HALO account sign-in is unavailable.';
  else client.auth.onAuthStateChange((_event, session) => {
    const view = ++generation;
    board.hidden = true;
    runnerAvailable = false;
    selectedRun = null;
    runnerVersion = '';
    runnerControls.replaceChildren();
    inbox.replaceChildren();
    drafts.replaceChildren();
    [next, campaigns, activities].forEach(node => node.replaceChildren());
    filter.replaceChildren(new Option('All campaigns', ''));
    filter.onchange = null;
    status.textContent = session ? 'Loading the marketing plan…' : 'Sign in with a HALO launch staff account.';
    if (session) window.setTimeout(() => void load(view), 0);
  });
  window.setInterval(() => {
    if (!board.hidden && !runnerBusy) void loadRunner(generation);
  }, 15000);
</script>
