---
const { compact = false } = Astro.props;
---

<section class:list={["experience", { compact }]} id="try">
  <div class="experience-copy">
    <p class="kicker">Try HALO now</p>
    <h2>{compact ? "Take the 1-60-7 Test" : "Start before you sign up."}</h2>
    <p>
      Write the decision, prove it with one tiny observable action, then carry
      the proof for seven days. No account required to begin.
    </p>
  </div>

  <div class="halo-test" data-halo-test>
    <div class="step-tabs" aria-label="1-60-7 progress">
      <span class="active" data-step-pill="card">1 Card</span>
      <span data-step-pill="proof">60 Seconds</span>
      <span data-step-pill="live">7 Days</span>
    </div>

    <div class="card-stage">
      <div class="index-card" data-card>
        <div class="card-face card-front">
          <span class="card-label">The Card - Side One</span>
          <div class="rules" aria-hidden="true"></div>
          <label class="card-prompt" for="identity-input">
            It already happened. I am
          </label>
          <input
            id="identity-input"
            data-identity-input
            class="card-input"
            type="text"
            autocomplete="off"
            placeholder="a person who keeps promises"
          />
          <div class="card-footer">
            <span>Present tense</span><span>Decide it</span>
          </div>
        </div>

        <div class="card-face card-back">
          <span class="card-label">The Card - Side Two</span>
          <div class="rules" aria-hidden="true"></div>
          <label class="card-question" for="proof-input">
            What would the person I&apos;ve decided to be do right now?
          </label>
          <input
            id="proof-input"
            data-proof-input
            class="card-input"
            type="text"
            autocomplete="off"
            placeholder="send the message"
          />
          <div class="card-footer">
            <span>Observable</span><span>Prove it</span>
          </div>
        </div>
      </div>
    </div>

    <div class="test-panel" data-panel="card">
      <p class="panel-label">1 - The card</p>
      <p>Finish the sentence on the card. Make it present-tense and decided.</p>
      <p class="panel-error" data-identity-error>
        Enter the identity first.
      </p>
      <button class="btn btn-primary" type="button" data-next-proof>
        Start the 60-second proof
      </button>
    </div>

    <div class="test-panel hidden" data-panel="proof">
      <p class="panel-label">60 - The proof</p>
      <p>Enter one tiny action you can do now. Then start the timer and do it.</p>
      <p class="panel-error" data-proof-error>
        Enter the action first.
      </p>
      <div class="timer" aria-live="polite">
        <span data-timer>60</span><small>seconds</small>
      </div>
      <div class="panel-actions">
        <button class="btn btn-primary" type="button" data-start-timer>
          Start timer
        </button>
        <button class="btn btn-ghost-dark" type="button" data-did-it disabled>
          I did it - stop timer
        </button>
      </div>
    </div>

    <div class="test-panel hidden" data-panel="live">
      <p class="panel-label">7 - Live it</p>
      <h3>That&apos;s proof. Now live from it for seven days.</h3>
      <p>
        HALO NOW keeps the card visible, captures evidence, and helps you reset
        quickly when the old pattern tries to come back.
      </p>
      <div class="seven-day-card" aria-label="Seven day tracker preview">
        <div>
          <strong>7-day tracker</strong>
          <span>Day 1 starts now. Mark one proof each day.</span>
        </div>
        <div class="day-dots" data-day-dots>
          <span class="done">1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span>
        </div>
      </div>
      <div class="reset-card">
        <strong>Reset tracker</strong>
        <span>If you miss, log the slip and the return. A reset keeps the signal alive.</span>
      </div>
      <a class="btn btn-primary app-link" href="/app/">
        Open HALO NOW tracker
      </a>
      <form
        class="signup-form"
        data-halo-form
        action="https://formspree.io/f/xreyqoab"
        method="POST"
      >
        <input type="hidden" name="identity" data-identity-hidden />
        <input type="hidden" name="proof" data-proof-hidden />
        <input
          type="email"
          name="email"
          placeholder="you@example.com"
          aria-label="Email address"
          required
        />
        <button type="submit">Take HALO with me</button>
      </form>
      <p class="share-copy">
        I tried 1607. 1 card. 60 seconds. 7 days. Try HALO Now.
      </p>
      <p class="privacy-note">
        Your card stays private unless you choose to share it.
      </p>
      <p class="wl-confirm" data-confirm>
        It already happened. You&apos;re on the list.
      </p>
    </div>
  </div>
</section>

<style>
  .experience{display:grid;grid-template-columns:.82fr 1.18fr;gap:3rem;align-items:start}
  .experience.compact{grid-template-columns:1fr;max-width:820px;margin:0 auto}
  .experience-copy h2{font-family:var(--serif-display);font-size:clamp(2rem,4vw,3.3rem);line-height:1.04;color:var(--paper);font-weight:300;letter-spacing:.04em}
  .paper .experience-copy h2{color:var(--ink)}
  .experience-copy p:not(.kicker){color:rgba(255,255,255,.72);max-width:38ch;margin-top:1rem}
  .paper .experience-copy p:not(.kicker){color:var(--ink-soft)}
  .kicker{font-family:var(--mono);font-size:.68rem;letter-spacing:.3em;text-transform:uppercase;color:var(--muted,rgba(255,255,255,.62));margin-bottom:1.1rem}
  .btn{display:inline-block;font-family:var(--mono);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;text-decoration:none;padding:.9rem 1.25rem;border-radius:999px;transition:transform .12s,background .15s,border-color .15s;border:0;cursor:pointer}
  .btn:active{transform:translateY(1px)}
  .btn-primary{background:var(--paper);color:var(--evergreen);font-weight:700}
  .btn-primary:hover{background:#eee}
  .btn-ghost-dark{border:1px solid rgba(255,255,255,.32);color:var(--paper);background:transparent}
  .btn:disabled{opacity:.48;cursor:not-allowed}
  .halo-test{border:1px solid rgba(255,255,255,.16);border-radius:32px;padding:1.2rem;background:#050505;box-shadow:0 24px 70px rgba(0,0,0,.18)}
  .paper .halo-test{border-color:#0f0f0f;background:#050505;box-shadow:0 14px 40px rgba(0,0,0,.12)}
  .step-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem;margin-bottom:1rem;font-family:var(--mono);font-size:.64rem;letter-spacing:.12em;text-transform:uppercase}
  .step-tabs span{border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:.55rem .4rem;color:rgba(255,255,255,.55);text-align:center}
  .paper .step-tabs span{border-color:rgba(255,255,255,.18);color:rgba(255,255,255,.55)}
  .step-tabs .active{background:var(--paper);color:var(--evergreen);border-color:var(--paper)}
  .paper .step-tabs .active{background:var(--paper);color:var(--evergreen);border-color:var(--paper)}
  .card-stage{perspective:1200px}
  .index-card{position:relative;width:100%;max-width:520px;aspect-ratio:5/3.15;margin:0 auto;transform-style:preserve-3d;-webkit-transform-style:preserve-3d;transition:transform .65s cubic-bezier(.2,.7,.2,1)}
  .index-card.flipped{transform:rotateY(180deg)}
  .index-card.flipped .card-front{opacity:0;visibility:hidden;pointer-events:none}
  .index-card.flipped .card-back{opacity:1;visibility:visible;pointer-events:auto}
  .card-face{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;background:var(--paper);border-radius:20px;box-shadow:0 20px 48px rgba(0,0,0,.35),0 2px 6px rgba(0,0,0,.18);padding:1.3rem 1.45rem;overflow:hidden;transform:translateZ(0);transition:opacity .2s ease,visibility .2s ease}
  .card-front{opacity:1;visibility:visible;pointer-events:auto}
  .card-back{opacity:0;visibility:hidden;pointer-events:none;transform:rotateY(180deg) translateZ(1px)}
  .card-face::before{content:"";position:absolute;left:0;right:0;top:2.55rem;height:2px;background:var(--card-headrule);opacity:.72}
  .rules{position:absolute;left:0;right:0;top:4.25rem;bottom:1rem;background:repeating-linear-gradient(to bottom,transparent 0,transparent 27px,var(--card-rule) 27px,var(--card-rule) 28px)}
  .card-label,.card-prompt,.card-question,.card-input,.card-footer{position:relative;z-index:2}
  .card-label{display:block;font-family:var(--mono);font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft)}
  .card-prompt,.card-question{display:block;margin-top:2.45rem;font-family:var(--serif-body);font-size:clamp(1rem,2.4vw,1.28rem);color:var(--ink)}
  .card-question{font-family:var(--hand);font-size:clamp(1.35rem,3vw,1.8rem);font-weight:600;color:var(--pen);line-height:1.2}
  .card-input{width:100%;margin-top:.6rem;border:0;border-bottom:2px solid var(--card-rule);background:transparent;color:var(--pen);font-family:var(--hand);font-size:clamp(1.5rem,4vw,2.25rem);font-weight:600;outline:none}
  .card-input::placeholder{color:rgba(23,53,95,.36)}
  .card-footer{position:absolute;bottom:1rem;left:1.45rem;right:1.45rem;display:flex;justify-content:space-between;font-family:var(--mono);font-size:.58rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft)}
  .test-panel{margin-top:1rem;border:1px solid rgba(255,255,255,.14);border-radius:24px;padding:1rem;color:var(--paper);background:#0d0d0d}
  .paper .test-panel{border-color:rgba(255,255,255,.14);background:#0d0d0d;color:var(--paper)}
  .test-panel.hidden,.hidden{display:none}
  .panel-label{font-family:var(--mono);font-size:.66rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.6);margin-bottom:.35rem}
  .panel-error{display:none;margin:.45rem 0 0;color:#B94A55!important;font-family:var(--mono);font-size:.64rem;letter-spacing:.08em;text-transform:uppercase}
  .panel-error.visible{display:block}
  .test-panel h3{font-family:var(--serif-display);font-size:1.45rem;line-height:1.15;margin-bottom:.45rem}
  .test-panel p:not(.panel-label):not(.panel-error):not(.privacy-note):not(.share-copy):not(.wl-confirm){color:rgba(252,251,247,.72)}
  .paper .test-panel p:not(.panel-label):not(.panel-error):not(.privacy-note):not(.share-copy):not(.wl-confirm){color:rgba(255,255,255,.7)}
  .timer{display:flex;align-items:baseline;gap:.4rem;margin:1rem 0;font-family:var(--serif-display);color:var(--paper)}
  .paper .timer{color:var(--paper)}
  .timer span{font-size:3rem;line-height:1}
  .timer small{font-family:var(--mono);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase}
  .panel-actions,.signup-form{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1rem}
  .panel-actions .btn{flex:1;min-width:170px}
  .seven-day-card,.reset-card{margin-top:1rem;border:1px solid rgba(255,255,255,.14);border-radius:18px;padding:.85rem .9rem;background:rgba(255,255,255,.06)}
  .paper .seven-day-card,.paper .reset-card{border-color:rgba(255,255,255,.14);background:rgba(255,255,255,.06)}
  .seven-day-card strong,.reset-card strong{display:block;font-family:var(--serif-display);font-size:1.05rem;color:inherit}
  .seven-day-card span,.reset-card span{display:block;color:rgba(252,251,247,.7);font-size:.9rem;margin-top:.2rem}
  .paper .seven-day-card span,.paper .reset-card span{color:var(--ink-soft)}
  .day-dots{display:grid;grid-template-columns:repeat(7,1fr);gap:.4rem;margin-top:.75rem}
  .day-dots span{display:flex;align-items:center;justify-content:center;aspect-ratio:1;border:1px solid rgba(252,251,247,.22);border-radius:999px;font-family:var(--mono);font-size:.62rem;color:rgba(252,251,247,.72)}
  .paper .day-dots span{border-color:#d8d3c6;color:var(--ink-soft)}
  .day-dots span.done{background:var(--teal);border-color:var(--teal);color:#fff}
  .app-link{display:block;text-align:center;margin-top:1rem}
  .signup-form input{flex:1;min-width:210px;border:1.5px solid #d8d3c6;border-radius:3px;padding:.85rem 1rem;font-family:var(--serif-body);font-size:1rem}
  .signup-form button{border:0;border-radius:3px;background:var(--evergreen);color:var(--paper);cursor:pointer;font-family:var(--mono);font-size:.72rem;font-weight:700;letter-spacing:.12em;padding:.9rem 1rem;text-transform:uppercase}
  .share-copy{margin-top:1rem;color:var(--pen);font-family:var(--hand);font-size:1.45rem;font-weight:600}
  .privacy-note{margin-top:.35rem;color:var(--ink-soft);font-family:var(--mono);font-size:.64rem;letter-spacing:.08em;text-transform:uppercase}
  .wl-confirm{display:none;margin-top:1rem;color:var(--pen);font-family:var(--hand);font-size:1.45rem;font-weight:600}
  @media(max-width:900px){.experience{grid-template-columns:1fr}}
</style>

<script>
  document.querySelectorAll("[data-halo-test]").forEach((root) => {
    const card = root.querySelector("[data-card]");
    const identityInput = root.querySelector("[data-identity-input]");
    const proofInput = root.querySelector("[data-proof-input]");
    const timerEl = root.querySelector("[data-timer]");
    const didIt = root.querySelector("[data-did-it]");
    const identityError = root.querySelector("[data-identity-error]");
    const proofError = root.querySelector("[data-proof-error]");
    const panels = root.querySelectorAll("[data-panel]");
    const pills = root.querySelectorAll("[data-step-pill]");
    const form = root.querySelector("[data-halo-form]");
    const confirm = root.querySelector("[data-confirm]");
    let remaining = 60;
    let interval;
    function show(step){
      panels.forEach((panel)=>panel.classList.toggle("hidden", panel.dataset.panel !== step));
      pills.forEach((pill)=>pill.classList.toggle("active", pill.dataset.stepPill === step));
      card.classList.toggle("flipped", step !== "card");
    }
    root.querySelector("[data-next-proof]").addEventListener("click", () => {
      if (!identityInput.value.trim()) {
        identityError.classList.add("visible");
        identityInput.focus();
        return;
      }
      identityError.classList.remove("visible");
      show("proof");
      proofInput.focus();
    });
    root.querySelector("[data-start-timer]").addEventListener("click", (event) => {
      if (!proofInput.value.trim()) {
        proofError.classList.add("visible");
        proofInput.focus();
        return;
      }
      proofError.classList.remove("visible");
      event.currentTarget.disabled = true;
      didIt.disabled = false;
      didIt.focus();
      clearInterval(interval);
      remaining = 60;
      timerEl.textContent = String(remaining);
      interval = window.setInterval(() => {
        remaining -= 1;
        timerEl.textContent = String(Math.max(0, remaining));
        if (remaining <= 0) clearInterval(interval);
      }, 1000);
    });
    didIt.addEventListener("click", () => {
      clearInterval(interval);
      timerEl.textContent = "done";
      root.querySelector("[data-identity-hidden]").value = identityInput.value.trim();
      root.querySelector("[data-proof-hidden]").value = proofInput.value.trim();
      show("live");
    });
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector("button");
      const originalText = button.textContent;
      button.textContent = "Saving...";
      button.disabled = true;
      try {
        const response = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
        if (!response.ok) throw new Error("Signup failed");
        form.style.display = "none";
        confirm.style.display = "block";
      } catch {
        button.textContent = originalText;
        button.disabled = false;
        confirm.textContent = "Something went wrong. Please try again.";
        confirm.style.display = "block";
      }
    });
  });
</script>
