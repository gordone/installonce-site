---
import identities from '../data/reader-identities.json';
import HaloLogo from './HaloLogo.astro';
const domains = [...new Set(identities.map(item => item.domain))];
const tools = ['Identity Menu', 'Identity Audit', 'Installation Worksheet', 'The Card', 'Integrity Check', '7-Day Tracker', 'Evidence & Report', 'HALO Board'];
const integrity = ['What identity did I choose?', 'What did I do today that proves it?', 'Where am I still negotiating?', 'What am I calling preparation that is actually avoidance?', 'What slipped, and how fast did I reset?', 'If someone watched my last seven days, what identity would they see?', 'What is the next aligned action?'];
const zones = ['Body', 'Vision', 'Relationships', 'Wealth', 'Career', 'Home', 'Growth', 'Adventure'];
---
<section class="reader-tools" data-reader-tools id="reader-tools">
  <header><HaloLogo /><p>READER TOOLS</p><h2>Your decided life.</h2><p><b>H</b>appened <b>A</b>lready. <b>L</b>ive <b>O</b>n.</p></header>
  <label class="tool-picker">Tool<select data-tool-picker>{tools.map((name, i) => <option value={i}>{name}</option>)}</select></label>
  <p class="save-status" data-save-status role="status">Saved on this browser. Other devices have separate entries.</p>
  <div data-tool-panel="0">
    <h3>Choose one identity</h3>
    <div class="fields"><label>Search<input type="search" data-search placeholder="Identity, attribute or question" /></label><label>Domain<select data-domain><option value="">All domains</option>{domains.map(d => <option>{d}</option>)}</select></label></div>
    <p data-results aria-live="polite"></p>
    <div class="identity-list">{identities.map(item => <details data-identity data-domain-name={item.domain} data-search-text={`${item.statement} ${item.attributes} ${item.question}`.toLowerCase()}><summary>{item.statement}<small>{item.domain}</small></summary><p>{item.attributes}</p><label>My starting point<select data-degree>{item.degrees.map(d => <option>{d}</option>)}</select></label><blockquote>{item.question}</blockquote><button type="button" data-choose={item.id}>Choose this identity</button></details>)}</div>
    <label>Or write your own<input data-custom placeholder="I am..." maxlength="200" /></label><button type="button" data-use-custom>Use my identity</button>
  </div>
  <div data-tool-panel="1" hidden><h3>Identity Audit</h3><div data-audit-rows></div><button type="button" data-add-audit>Add a domain</button></div>
  <div data-tool-panel="2" hidden><h3>Installation Worksheet</h3><label>My identity<input data-field="identity" maxlength="200" /></label>{['Therefore...', 'So...', 'And so...', 'Which means...', 'One more implication'].map((name,i) => <label>{name}<textarea data-field={`implication${i}`} rows="2" maxlength="800" /></label>)}<label>One incompatible behavior to remove<textarea data-field="remove" rows="2" maxlength="800" /></label><label>My next visible action<input data-field="action" maxlength="300" /></label><button type="button" data-open-card>Make my card</button></div>
  <div data-tool-panel="3" hidden><h3>The Installation</h3><div class="reader-card"><small data-card-side>THE DECISION</small><p data-card-text></p></div><button type="button" data-flip>Turn card</button><label>My next visible action<input data-field="action" maxlength="300" /></label><output class="reader-timer" data-timer>60</output><div class="commands"><button type="button" data-start-timer>Start 60 seconds</button><button type="button" data-stop-timer disabled>Action complete</button></div><p data-timer-status role="status"></p><a href="/app/">Open my daily practice</a></div>
  <div data-tool-panel="4" hidden><h3>Integrity Check</h3>{integrity.map((q,i) => <label>{i+1}. {q}<textarea data-field={`integrity${i}`} rows="2" maxlength="1200" /></label>)}<p>Observation, not judgment. Return to one visible action.</p><button type="button" data-use-action>Use my next aligned action</button></div>
  <div data-tool-panel="5" hidden><h3>Seven days of evidence</h3><div class="commands"><button type="button" data-start-week>Start my 7-day test</button><button type="button" data-reset-week>Reset tracker</button></div><p data-week-status></p><label>Day<select data-day>{Array.from({length:7},(_,i) => <option value={i}>{i+1}</option>)}</select></label><form data-day-form><label>Proving action<textarea name="action" required maxlength="600" rows="2" /></label><label>Negotiation (minutes)<input name="negotiation" type="number" min="0" max="1440" step="1" required /></label><label>Action started within 60 seconds?<select name="within"><option value="">Choose</option><option value="yes">Yes</option><option value="no">No</option></select></label><label>Did I slip?<select name="slip"><option value="no">No</option><option value="yes">Yes</option></select></label><div data-slip-fields hidden><label>Did I reset that day?<select name="reset"><option value="no">Not yet</option><option value="yes">Yes</option></select></label><label>Return speed (minutes)<input name="returnSpeed" type="number" min="0" max="1440" step="1" /></label></div><label>Buffer protected?<select name="buffer"><option value="na">Not applicable</option><option value="yes">Yes</option><option value="no">No</option></select></label><button type="submit">Save day</button></form><p data-day-feedback role="status"></p></div>
  <div data-tool-panel="6" hidden><h3>Evidence & Report</h3><p data-report-identity></p><div class="seven-days" data-evidence></div><p>✓ Aligned action · ↺ Slipped and reset · — Return still open</p><label>Days recorded<progress max="7" value="0" data-progress /></label><div data-report aria-live="polite"></div><label>Did I behave differently because the decision was settled first?<textarea data-field="verdict" rows="3" maxlength="1500" /></label><label>What will I keep or fine-tune?<textarea data-field="nextWeek" rows="3" maxlength="1500" /></label><button type="button" data-next-week>Archive and begin another 7 days</button><div data-archives></div></div>
  <div data-tool-panel="7" hidden><h3>HALO Board</h3><label>My word<input data-field="word" maxlength="60" /></label><div class="halo-zones">{zones.map(zone => <article><h4>{zone}</h4><img data-zone-image={zone} alt={`${zone} reference`} hidden /><label>Choose image<input type="file" accept="image/jpeg,image/png,image/webp" data-zone-upload={zone} /></label><label>What this means<textarea data-field={`zone${zone}`} rows="2" maxlength="300" /></label><button type="button" data-remove-image={zone}>Remove image</button></article>)}</div></div>
  <footer class="commands"><button type="button" data-export>Export my tools</button><button type="button" data-print>Print current tool</button></footer>
</section>
<style is:global>
 .reader-tools{color:#141414;background:#fff;font:16px/1.6 Arial,sans-serif;max-width:1000px;margin:auto;padding:32px 20px;letter-spacing:0}.reader-tools *{box-sizing:border-box;letter-spacing:0}.reader-tools [hidden]{display:none!important}.reader-tools header{border-bottom:2px solid #111;padding-bottom:20px;margin-bottom:24px}.reader-tools h2{font-size:32px;font-weight:300;line-height:1.2;margin:12px 0}.reader-tools h3{font-size:24px;margin:20px 0}.reader-tools h4{font-size:18px;margin:0 0 12px}.reader-tools label{display:block;margin:16px 0;font-size:14px;font-weight:600}.reader-tools input,.reader-tools select,.reader-tools textarea{display:block;width:100%;min-width:0;min-height:44px;border:1px solid #888;border-radius:4px;padding:10px;font:16px/1.4 Arial,sans-serif;background:#fff;color:#111;margin-top:6px}.reader-tools input[type=file]{font-size:13px}.reader-tools textarea{resize:vertical}.reader-tools button,.reader-tools a{font:600 14px/1.4 Arial,sans-serif;display:inline-block;background:#111;color:#fff;padding:12px 16px;border:1px solid #111;border-radius:4px;cursor:pointer;min-height:44px;white-space:normal;text-decoration:none}.reader-tools button:disabled{opacity:.4;cursor:not-allowed}.reader-tools :focus-visible{outline:3px solid #137b70;outline-offset:3px}.reader-tools p{margin:12px 0}.reader-tools .fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}.reader-tools details{border-bottom:1px solid #ccc;padding:16px 0}.reader-tools summary{cursor:pointer;font-weight:600;min-height:44px}.reader-tools small{display:block;font-size:12px;font-weight:400;color:#555}.reader-tools blockquote{border-left:3px solid #137b70;padding:8px 16px;margin:16px 0}.reader-tools .save-status{font-size:12px;color:#555}.reader-tools .commands{display:flex;flex-wrap:wrap;gap:10px;margin:20px 0}.reader-tools .reader-card{border:1px solid #777;padding:28px;min-height:230px;display:flex;flex-direction:column;justify-content:center;background:repeating-linear-gradient(#fff 0px,#fff 35px,#eee 36px);border-radius:8px;overflow-wrap:anywhere}.reader-tools .reader-card p{font-size:26px;line-height:1.4}.reader-tools .reader-timer{display:block;font-size:48px;font-variant-numeric:tabular-nums}.reader-tools .seven-days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px}.reader-tools .seven-days button{padding:10px 1px;background:#f5f5f5;color:#111;border-color:#bbb;min-height:70px;font-size:13px}.reader-tools .seven-days .proved{background:#e2f3ec;border-color:#187158}.reader-tools .seven-days .reset{background:#fff1c9;border-color:#9c7220}.reader-tools progress{display:block;width:100%;height:14px;accent-color:#187158}.reader-tools .halo-zones{display:grid;grid-template-columns:1fr 1fr;gap:24px}.reader-tools article{border-top:1px solid #aaa;padding-top:20px;min-width:0}.reader-tools img{width:100%;aspect-ratio:4/3;object-fit:contain;background:#eee}.reader-tools .audit-row{border-bottom:1px solid #aaa;padding:16px 0}.reader-tools [data-report]{border-left:3px solid #137b70;padding:4px 20px;margin:24px 0;animation:report-in .4s ease}.reader-tools .identity-list{max-height:560px;overflow:auto}.reader-tools footer{border-top:1px solid #ccc;padding-top:20px}@keyframes report-in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}@media(max-width:550px){.reader-tools{padding:24px 12px}.reader-tools .fields,.reader-tools .halo-zones{grid-template-columns:1fr}.reader-tools h2{font-size:28px}.reader-tools .reader-card{padding:20px}.reader-tools .reader-card p{font-size:22px}}@media(prefers-reduced-motion:reduce){.reader-tools [data-report]{animation:none}}@media print{.reader-tools button,.reader-tools footer,.tool-picker,.save-status{display:none!important}.reader-tools .identity-list{max-height:none}.reader-tools{max-width:none;padding:0}}
</style>
<style is:global>
  .reader-tools footer{background:transparent}
  .reader-tools button,.reader-tools a{max-width:100%;overflow-wrap:anywhere}
  .reader-tools .fields{grid-template-columns:repeat(2,minmax(0,1fr))}
  @media(max-width:550px){.reader-tools .fields{grid-template-columns:minmax(0,1fr)}}
</style>
<script>
 import '../scripts/reader-tools';
</script>
