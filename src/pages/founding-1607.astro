---
import HaloLogo from "../components/HaloLogo.astro";
import { founding1607Metrics, founding1607Views } from "../data/haloFlywheel";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Founding 1607 - The HALO Method</title>
    <meta
      name="description"
      content="The Founding 1607 dashboard tracks the HALO launch cohort and the First 167 people who complete the full 1-60-7 protocol."
    />
    <link rel="canonical" href="https://thehalomethod.co/founding-1607/" />
    <style>
      :root{--black:#010101;--white:#fff;--line:#e5e5df;--muted:#747474;--ink:#0c0c0c;--ink-soft:#616161;--paper:#f7f7f4;--mono:ui-monospace,'SF Mono',Menlo,monospace;--display:Inter,Arial,sans-serif;--body:Georgia,serif}
      *{box-sizing:border-box;margin:0;padding:0}
      body{background:var(--white);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.65}
      .shell{max-width:1180px;margin:0 auto;padding:1.4rem 1.5rem 5rem}
      nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:4rem}
      nav a{color:inherit;text-decoration:none}
      nav a:not(.brand){font-family:var(--mono);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft)}
      .brand{display:inline-flex}
      .hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.78fr);gap:2rem;align-items:end}
      .kicker{font-family:var(--mono);font-size:.68rem;letter-spacing:.3em;text-transform:uppercase;color:var(--muted);margin-bottom:1rem}
      h1{font-family:var(--display);font-size:clamp(3rem,8vw,7rem);line-height:.92;font-weight:500;letter-spacing:-.04em;max-width:9ch}
      .lede{max-width:54ch;color:var(--ink-soft);font-size:1.08rem;margin-top:1.3rem}
      .honor{background:var(--black);color:var(--white);border-radius:34px;padding:1.5rem;min-height:360px;display:flex;flex-direction:column;justify-content:space-between}
      .honor strong{display:block;font-family:var(--display);font-size:clamp(4rem,12vw,8rem);line-height:.85}
      .honor span{font-family:var(--mono);font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.68)}
      .metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:4rem}
      .metric{border:1px solid var(--line);border-radius:20px;padding:1rem;background:#fff}
      .metric span{font-family:var(--mono);font-size:.65rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
      .metric strong{display:block;margin-top:.5rem;font-family:var(--display);font-size:2.25rem;line-height:1}
      .metric p{margin-top:.6rem;color:var(--ink-soft);font-size:.92rem}
      .views{margin-top:3rem;background:var(--paper);border-radius:28px;padding:1.4rem}
      .view-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem;margin-top:1rem}
      .view{background:#fff;border:1px solid var(--line);border-radius:16px;padding:1rem;font-family:var(--display);font-weight:600}
      .rules{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:3rem}
      .rule{border-top:1px solid var(--black);padding-top:1rem}
      .rule h2{font-family:var(--display);font-size:1.45rem;line-height:1.1}
      .rule p{margin-top:.6rem;color:var(--ink-soft)}
      @media(max-width:860px){.hero,.metrics,.view-grid,.rules{grid-template-columns:1fr}nav{margin-bottom:2.5rem}}
    </style>
  </head>
  <body>
    <main class="shell">
      <nav aria-label="Founding 1607 navigation">
        <a class="brand" href="/" aria-label="HALO home"><HaloLogo /></a>
        <a href="/start/">Start 1-60-7</a>
      </nav>

      <section class="hero">
        <div>
          <p class="kicker">Launch cohort</p>
          <h1>Founding 1607.</h1>
          <p class="lede">
            Founding 1607 is the launch movement: 1,607 invited people proving
            one identity for seven days. The First 167 who complete the full
            protocol become the public honor roll.
          </p>
        </div>
        <aside class="honor" aria-label="First 167 honor roll">
          <span>Public honor roll</span>
          <strong>167</strong>
          <span>First completers, not first signups</span>
        </aside>
      </section>

      <section class="metrics" aria-label="Founding 1607 metrics">
        {founding1607Metrics.map((metric) => (
          <article class="metric">
            <span>{metric.label}</span>
            <strong>{metric.target ?? "-"}</strong>
            <p>{metric.description}</p>
          </article>
        ))}
      </section>

      <section class="views" aria-label="Dashboard views">
        <p class="kicker">Dashboard views</p>
        <div class="view-grid">
          {founding1607Views.map((view) => <div class="view">{view}</div>)}
        </div>
      </section>

      <section class="rules" aria-label="Operating rules">
        <article class="rule">
          <h2>Track all 1,607 privately.</h2>
          <p>
            The operator dashboard should track invitations, starts, proof,
            progress, shares, referrals, and story candidates for the full
            cohort.
          </p>
        </article>
        <article class="rule">
          <h2>Show only the First 167 publicly.</h2>
          <p>
            Scarcity belongs to completion. Public proof should be the first 167
            people who complete seven days, plus aggregate stats and opt-in
            stories.
          </p>
        </article>
      </section>
    </main>
  </body>
</html>
