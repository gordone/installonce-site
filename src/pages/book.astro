---
import HaloLogo from '../components/HaloLogo.astro';
import { chapters } from '../data/book-chapters';
const orderedChapters = [...chapters].sort((a, b) => a.number - b.number);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reader Library | HALO</title>
    <meta name="description" content="HALO chapter materials, reader tools and the seven-day test." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip" href="#library">Skip to reader library</a>
    <header>
      <a href="/" aria-label="HALO home"><HaloLogo /></a>
      <nav aria-label="Reader navigation"><a href="/#reader-tools">Reader tools</a><a href="/app/">Open app</a></nav>
    </header>
    <main id="library">
      <p class="eyebrow">THE BOOK</p>
      <h1>Reader library</h1>
      <p class="tagline"><b>H</b>appened <b>A</b>lready. <b>L</b>ive <b>O</b>n.</p>
      <section aria-labelledby="chapters-heading">
        <h2 id="chapters-heading">By chapter</h2>
        {orderedChapters.length === 0 ? <p class="empty">Chapter materials are coming soon.</p> :
          orderedChapters.map(chapter => (
            <details id={chapter.slug}>
              <summary><span class="number">Chapter {chapter.number}</span><span>{chapter.title}</span></summary>
              <div class="chapter-content">
                <p>{chapter.description}</p>
                {chapter.materials.length ? <ul>{chapter.materials.map(material => (
                  <li><a href={material.href}>{material.title}<span class="format">{material.format}</span></a><p>{material.description}</p></li>
                ))}</ul> : <p>Materials for this chapter are coming soon.</p>}
              </div>
            </details>
          ))}
      </section>
      <section aria-labelledby="available-heading">
        <h2 id="available-heading">Available now</h2>
        <ul class="available">
          <li><a href="/#reader-tools">Reader tools <span aria-hidden="true">&#8599;</span></a><p>Identity menu, worksheets, integrity check and evidence tracker.</p></li>
          <li><a href="/1607/">The 1 &#8226; 60 &#8226; 7 test <span aria-hidden="true">&#8599;</span></a><p>One card. One action. Seven days.</p></li>
          <li><a href="/app/">HALO NOW <span aria-hidden="true">&#8599;</span></a><p>Your card, daily evidence and seven-day report.</p></li>
        </ul>
      </section>
    </main>
    <footer><a href="/">Install Once</a><span>HALO reader materials</span></footer>
  </body>
</html>
<style>
  :global(body){margin:0;background:#fff;color:#111;font:16px/1.6 Arial,sans-serif}
  *{box-sizing:border-box;letter-spacing:0}
  a{color:inherit;text-underline-offset:4px}
  a:focus-visible,summary:focus-visible{outline:2px solid #111;outline-offset:5px}
  header,footer{max-width:1100px;margin:auto;padding:24px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
  header{border-bottom:1px solid #ddd}header>a{display:flex;align-items:center;min-height:44px}nav{display:flex;gap:24px}nav a{display:inline-flex;align-items:center;min-height:44px}
  main{max-width:960px;margin:auto;padding:48px 24px 64px}h1{font-size:48px;line-height:1.1;font-weight:300;margin:12px 0 20px}h2{font-size:24px;font-weight:400;margin:0 0 20px}.eyebrow,.number,.format{font-size:13px;color:#555}.tagline{font-size:20px}.tagline b{font-weight:800}section{margin-top:48px}.empty{padding:24px 0;border-block:1px solid #ddd;color:#555}
  details{border-top:1px solid #ccc;scroll-margin-top:24px}details:last-child{border-bottom:1px solid #ccc}summary{cursor:pointer;padding:20px 8px;min-height:64px;font-size:20px}summary .number{margin-right:16px}.chapter-content{padding:0 24px 24px}.chapter-content p{color:#555}.format{margin-left:16px}
  ul{list-style:none;padding:0;margin:0}li{padding:20px 0;border-top:1px solid #ddd}li a{min-height:44px;display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:19px;overflow-wrap:anywhere}li p{margin:8px 0 0;color:#555}.available{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}footer{border-top:1px solid #ddd;font-size:14px;color:#555}.skip{position:absolute;left:16px;top:-100px;background:#fff;padding:12px;z-index:10}.skip:focus{top:8px}
  @media(max-width:650px){h1{font-size:36px}main{padding-top:32px}.available{grid-template-columns:1fr;gap:0}nav{gap:16px}summary .number{display:block}header{gap:12px}}
</style>
