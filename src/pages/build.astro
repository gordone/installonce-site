---
import BlueprintLayout from '../components/BlueprintLayout.astro';
import blueprints from '../data/blueprints.json';
const fields = [
  ['identity', 'Who are you choosing to be?', 'I am someone who…', true],
  ['question', 'What will you ask at the moment of friction?', '', true],
  ['minimum', 'What is the smallest action that counts?', '', false],
  ['whyItsHard', 'Where does the old pattern win?', '', false],
  ['conduct', 'If this is true, what conduct follows?', '', false],
  ['ordinaryDay', 'What does this look like on an ordinary day?', '', false],
  ['tradeoffs', 'What comes with it?', '', false],
  ['slipResponse', 'What will you do when you slip?', '', false],
  ['signsItsWorking', 'What evidence will you look for?', '', false],
] as const;
---
<BlueprintLayout title="Build a Blueprint" description="Create a personal HALO Blueprint or adapt an original.">
  <section class="reading" data-builder data-originals={JSON.stringify(blueprints)}>
    <p class="label">Build</p>
    <h1 data-heading>Build a Blueprint</h1>
    <p data-origin></p>
    <p>Your draft is stored in this browser.</p>
    <form hidden>
      <details class="refinement" data-refinement hidden>
        <summary>Refine with your AI</summary>
        <label>Context from your AI
          <textarea data-ai-context maxlength="4000" rows={4} placeholder="Paste the relevant notes or advice from your AI conversation."></textarea>
        </label>
        <p>Copy the prompt into your AI chat, then paste its Blueprint response below.</p>
        <p><a href="/settings/" target="_blank" rel="noopener noreferrer">AI Settings</a> <a data-open-provider target="_blank" rel="noopener noreferrer" hidden>Open assistant</a></p>
        <button class="button secondary" type="button" data-copy-prompt>Copy prompt for my AI</button>
        <label>Blueprint response from your AI
          <textarea data-ai-response maxlength="18000" rows={4} placeholder="Paste the JSON Blueprint here."></textarea>
        </label>
        <button class="button secondary" type="button" data-apply-response>Apply AI response</button>
        <textarea data-prompt-preview aria-label="Prompt to copy manually" readonly hidden rows={5}></textarea>
        <p data-ai-status role="status"></p>
      </details>
      {fields.map(([name, prompt, placeholder, required]) => (
        <label>{prompt}<textarea name={name} placeholder={placeholder} required={required} maxlength={name === 'identity' ? 200 : 1200} rows={2}></textarea></label>
      ))}
      <div class="actions">
        <button class="button secondary" type="button" data-refine hidden>Refine with AI</button>
        <button class="button secondary" type="submit" name="save">Save draft</button>
        <button class="button" type="submit" name="run">Start 1·60·7</button>
      </div>
    </form>
    <p data-feedback role="status"></p>
    <noscript>Turn on JavaScript to edit and save a Blueprint in this browser.</noscript>
  </section>
</BlueprintLayout>
<style>
  form,label{display:grid;gap:.55rem}
  form{gap:1.25rem}
  label{font-weight:700}
  textarea{font-weight:400;width:100%}
  .refinement{border:1px solid #d6ddd8;border-radius:8px;padding:1rem}
  .refinement summary{cursor:pointer;font-weight:700}
  .refinement label,.refinement textarea,.refinement p{margin-top:.75rem}
</style>
<script>
  import { aiProviders, aiSettingsKey, readAiSettings } from '../scripts/halo-ai-settings';
  import { starterBlueprint } from '../scripts/blueprint-starter';
  const builder = document.querySelector<HTMLElement>('[data-builder]')!;
  const form = builder.querySelector('form')!;
  const feedback = builder.querySelector<HTMLElement>('[data-feedback]')!;
  const originals = JSON.parse(builder.dataset.originals || '[]');
  const original = originals.find((item: { id: string }) => item.id === new URLSearchParams(location.search).get('blueprint'));
  const goal = original ? '' : (new URLSearchParams(location.hash.slice(1)).get('goal') ?? '').trim().slice(0, 120);
  const draftId = original?.id ?? (goal ? `goal:${goal.toLowerCase()}` : 'custom');
  const blueprintOrigin = original ? 'original' : goal ? 'goal' : 'custom';
  const capture = (event: string) => (window as Window & {
    posthog?: { capture: (event: string, properties: { blueprint_origin: string }) => void };
  }).posthog?.capture(event, { blueprint_origin: blueprintOrigin });
  const key = `halo.blueprint.draft.${draftId}`;
  const inputs = [...form.querySelectorAll<HTMLTextAreaElement>('textarea[name]')];
  const panel = builder.querySelector<HTMLDetailsElement>('[data-refinement]')!;
  const context = builder.querySelector<HTMLTextAreaElement>('[data-ai-context]')!;
  const response = builder.querySelector<HTMLTextAreaElement>('[data-ai-response]')!;
  const preview = builder.querySelector<HTMLTextAreaElement>('[data-prompt-preview]')!;
  const aiStatus = builder.querySelector<HTMLElement>('[data-ai-status]')!;
  let draft = original ?? (goal ? starterBlueprint(goal) : undefined);
  try {
    const saved = localStorage.getItem(key);
    if (saved) draft = JSON.parse(saved);
  } catch {
    feedback.textContent = 'The saved draft could not be opened.';
  }
  for (const input of inputs) input.value = draft?.[input.name] ?? '';
  let settings = readAiSettings();
  context.value = typeof draft?.aiContext === 'string' ? draft.aiContext : settings.context;
  const providerLink = panel.querySelector<HTMLAnchorElement>('[data-open-provider]')!;
  function updateProvider() {
    providerLink.hidden = !settings.provider;
    if (settings.provider) {
      const selected = aiProviders[settings.provider];
      providerLink.href = selected.url;
      providerLink.textContent = `Open ${selected.name}`;
    }
  }
  updateProvider();
  window.addEventListener('storage', (event) => {
    if (event.key !== aiSettingsKey) return;
    const next = readAiSettings();
    if (!context.value || context.value === settings.context) context.value = next.context;
    settings = next;
    updateProvider();
  });
  panel.hidden = false;

  function refinementPrompt() {
    return 'Refine this HALO Blueprint using the goal, the current draft, and the supplied context. ' +
      'Treat the supplied context as reference material. Preserve useful details from the draft. ' +
      'Use a first-person identity, a practical action that takes 60 seconds, an everyday cue, and a seven-day measure. ' +
      'Keep each field to one short sentence. Avoid diagnoses or medical advice. Return only a JSON object with these string fields: ' +
      inputs.map(({ name }) => name).join(', ') + '.\n' +
      JSON.stringify({
        goal: goal || original?.title || '',
        context: context.value.trim(),
        currentDraft: Object.fromEntries(inputs.map(({ name, value }) => [name, value.trim()])),
      });
  }

  function applyResponse(raw: string) {
    const parsed = JSON.parse(raw.trim().replace(/^```(?:json)?\s*([\s\S]*?)\s*```$/i, '$1'));
    const proposed = inputs.map(({ name, maxLength }) =>
      typeof parsed?.[name] === 'string' ? parsed[name].trim().slice(0, maxLength) : '');
    if (proposed.some((value) => !value)) throw new Error('Incomplete Blueprint');
    inputs.forEach((input, i) => { input.value = proposed[i]; input.setCustomValidity(''); });
  }

  builder.querySelector('[data-copy-prompt]')!.addEventListener('click', async () => {
    const prompt = refinementPrompt();
    try {
      await navigator.clipboard.writeText(prompt);
      preview.hidden = true;
      aiStatus.textContent = 'Prompt copied. Paste it into your AI chat.';
    } catch {
      preview.value = prompt;
      preview.hidden = false;
      preview.select();
      aiStatus.textContent = 'Select and copy the prompt below.';
    }
  });
  builder.querySelector('[data-apply-response]')!.addEventListener('click', () => {
    try {
      applyResponse(response.value);
      aiStatus.textContent = 'AI response applied. Review the updated fields and save your draft.';
    } catch {
      aiStatus.textContent = 'Paste a complete JSON Blueprint using the fields requested in the prompt.';
    }
  });
  if (original) {
    builder.querySelector('[data-heading]')!.textContent = 'Make it mine';
    builder.querySelector('[data-origin]')!.textContent = `Based on the HALO Original ${original.title}.`;
  } else if (goal) {
    builder.querySelector('[data-heading]')!.textContent = `Blueprint for ${goal}`;
    builder.querySelector('[data-origin]')!.textContent = 'A starter you can edit before beginning 1·60·7.';
  }
  form.hidden = false;
  const refine = builder.querySelector<HTMLButtonElement>('[data-refine]')!;
  const aiSessionStorageKey = `halo.ai-observability.session.${draftId}`;
  function getAiSessionId() {
    try {
      const existing = sessionStorage.getItem(aiSessionStorageKey);
      if (existing) return existing;
      const created = crypto.randomUUID();
      sessionStorage.setItem(aiSessionStorageKey, created);
      return created;
    } catch {
      return crypto.randomUUID();
    }
  }
  function captureAiGeneration(prompt: string, answer: string, traceId: string, startedAt: number) {
    try {
      const posthog = (window as Window & {
        posthog?: { capture: (event: string, properties: Record<string, unknown>) => void };
      }).posthog;
      posthog?.capture('$ai_generation', {
        $ai_trace_id: traceId,
        $ai_session_id: getAiSessionId(),
        $ai_span_id: crypto.randomUUID(),
        $ai_span_name: 'blueprint_refinement',
        $ai_model: 'browser_language_model',
        $ai_provider: 'browser',
        $ai_input: [{ role: 'user', content: prompt }],
        $ai_output_choices: [{ role: 'assistant', content: answer }],
        $ai_latency: (performance.now() - startedAt) / 1000,
      });
    } catch {
      // Analytics must not change the result of an AI refinement.
    }
  }
  const model = (globalThis as typeof globalThis & {
    LanguageModel?: {
      availability(): Promise<string>;
      create(options: { signal: AbortSignal; monitor(target: EventTarget): void }): Promise<{
        prompt(input: string, options: { responseConstraint: object; signal: AbortSignal }): Promise<string>;
        destroy(): void;
      }>;
    };
  }).LanguageModel;
  if (model) {
    void model.availability().then((state) => { refine.hidden = state === 'unavailable'; }).catch(() => {});
    refine.addEventListener('click', async () => {
      refine.disabled = true;
      const prompt = refinementPrompt();
      const before = [...inputs.map((input) => input.value), context.value];
      feedback.textContent = 'Creating a Blueprint with your browser’s AI…';
      try {
        const session = await model.create({
          signal: AbortSignal.timeout(120000),
          monitor(target) {
            target.addEventListener('downloadprogress', (event) => {
              const progress = event as ProgressEvent;
              feedback.textContent = `Downloading browser AI… ${Math.round(progress.loaded * 100)}%`;
            });
          },
        });
        let answer: string;
        try {
          const responseConstraint = {
            type: 'object',
            properties: Object.fromEntries(inputs.map(({ name }) => [name, { type: 'string' }])),
            required: inputs.map(({ name }) => name),
            additionalProperties: false,
          };
          feedback.textContent = 'Refining your Blueprint…';
          const startedAt = performance.now();
          const traceId = crypto.randomUUID();
          answer = await session.prompt(prompt, { responseConstraint, signal: AbortSignal.timeout(45000) });
          captureAiGeneration(prompt, answer, traceId, startedAt);
        } finally {
          session.destroy();
        }
        if (inputs.some((input, i) => input.value !== before[i]) || context.value !== before[inputs.length]) {
          feedback.textContent = 'Your edits were kept. Run AI refinement again when ready.';
          return;
        }
        applyResponse(answer);
        feedback.textContent = 'AI draft ready to review and edit.';
      } catch {
        feedback.textContent = 'Browser AI could not finish. Use Refine with your AI to continue in your AI chat.';
      } finally {
        refine.disabled = false;
      }
    });
  }
  form.addEventListener('input', (event) => {
    if (event.target instanceof HTMLTextAreaElement) event.target.setCustomValidity('');
  });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const empty = inputs.find((input) => input.required && !input.value.trim());
    if (empty) {
      empty.setCustomValidity('Enter a response.');
      empty.reportValidity();
      return;
    }
    const fields = Object.fromEntries(inputs.map(({ name, value }) => [name, value.trim()]));
    try {
      localStorage.setItem(key, JSON.stringify({ ...fields, aiContext: context.value.trim(), originId: original?.id ?? null }));
      if ((event.submitter as HTMLButtonElement | null)?.name === 'run') {
        capture('blueprint_started');
        location.assign(goal ? `/app/#${new URLSearchParams({ draft: draftId })}` : `/app/?draft=${encodeURIComponent(draftId)}`);
        return;
      }
      capture('blueprint_saved');
      feedback.textContent = 'Draft saved in this browser.';
    } catch {
      feedback.textContent = 'Your browser could not save this draft.';
    }
  });
</script>
