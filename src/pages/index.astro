<script>
// Typing loop on the hero card
(function(){
  var identities = ["a healthy person.", "a wealth builder.", "a present parent.", "a writer.", "a business owner.", "calm under pressure."];
  var el = document.getElementById('typed');
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced) { el.textContent = identities[0]; return; }
  var i = 0, ch = 0, deleting = false;
  function tick(){
    var word = identities[i];
    if (!deleting) {
      ch++;
      el.textContent = word.slice(0, ch);
      if (ch === word.length) { deleting = true; return setTimeout(tick, 2200); }
      return setTimeout(tick, 65 + Math.random()*70);
    } else {
      ch--;
      el.textContent = word.slice(0, ch);
      if (ch === 0) { deleting = false; i = (i+1) % identities.length; return setTimeout(tick, 500); }
      return setTimeout(tick, 30);
    }
  }
  setTimeout(tick, 900);
})();

// Card flip
(function(){
  var card = document.getElementById('heroCard');
  function flip(){ card.classList.toggle('flipped'); }
  card.addEventListener('click', flip);
  card.addEventListener('keydown', function(e){ if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); } });
})();

// Scroll reveals
(function(){
  var els = document.querySelectorAll('.reveal');
  if (!('IntersectionObserver' in window)) { els.forEach(function(el){ el.classList.add('in'); }); return; }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(en){ if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
  }, { threshold: 0.12 });
  els.forEach(function(el){ io.observe(el); });
})();

// Waitlist
(function(){
  var form = document.getElementById('wlForm');
  var confirm = document.getElementById('wlConfirm');
  form.addEventListener('submit', async function(e){
    e.preventDefault();
    var email = document.getElementById('wlEmail').value.trim();
    if (!email) return;
    var button = form.querySelector('button');
    var originalText = button.textContent;
    button.textContent = 'Joining...';
    button.disabled = true;
    try {
      var response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' }
      });
      if (!response.ok) throw new Error('Waitlist signup failed');
      form.style.display = 'none';
      confirm.style.display = 'block';
      form.reset();
    } catch (error) {
      button.textContent = originalText;
      button.disabled = false;
      confirm.textContent = 'Something went wrong. Please try again.';
      confirm.style.display = 'block';
      confirm.style.color = '#B94A55';
    }
  });
})();
</script>
