---
import Halo1607Experience from "../components/Halo1607Experience.astro";
import "../styles/global.css";
---

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HALO - Identity for Lasting Change</title>
<meta name="description" content="Take the 1 • 60 • 7 Test. Decide who you are, prove it with one action in the next 60 seconds, then live from the decision for seven days.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Caveat:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{--black:#010101;--charcoal:#111;--smoke:#f7f7f4;--white:#fff;--line:#e5e5df;--muted:#747474;--ink:#0c0c0c;--ink-soft:#616161;--paper:#fff;--paper-shade:#f6f6f1;--evergreen:#010101;--evergreen-deep:#010101;--teal:#111;--teal-bright:#fff;--card-rule:#d8d8d8;--card-headrule:#111;--pen:#111;--serif-display:Inter,Arial,sans-serif;--serif-body:'Source Serif 4',Georgia,serif;--hand:'Caveat',cursive;--mono:ui-monospace,'SF Mono',Menlo,monospace}
*{margin:0;padding:0;box-sizing:border-box}html{scroll-behavior:smooth}body{font-family:var(--serif-body);color:var(--ink);background:var(--white);font-size:17px;line-height:1.65}a{color:inherit}::selection{background:var(--black);color:#fff}:focus-visible{outline:2px solid var(--black);outline-offset:3px}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}}
nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.86);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}
.nav-inner{max-width:1180px;margin:0 auto;padding:1rem 1.5rem;display:flex;align-items:center;justify-content:space-between}.wordmark{font-family:var(--serif-display);font-weight:300;font-size:1.1rem;letter-spacing:.62em;color:var(--black);text-decoration:none;position:relative}.wordmark .ring{position:absolute;top:-.3em;left:50%;transform:translateX(-50%) rotate(-8deg);width:1.25em;height:.42em;border:1.25px solid currentColor;border-radius:50%;opacity:.9}.nav-links{display:flex;gap:1.25rem;align-items:center;list-style:none}.nav-links a{font-family:var(--mono);font-size:.66rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);text-decoration:none;transition:color .15s}.nav-links a:hover,.nav-links a:focus-visible{color:var(--black)}.nav-cta{background:var(--black);color:var(--white)!important;padding:.58rem 1rem;border-radius:999px;font-weight:600}.nav-cta:hover{background:#222}@media(max-width:760px){.nav-links li:not(:last-child){display:none}.wordmark{letter-spacing:.45em}}
.hero{max-width:1180px;margin:0 auto;padding:1.3rem 1.5rem 4.5rem;display:grid;grid-template-columns:1fr;gap:2rem;align-items:center}
.hero>div:first-child{min-height:72vh;border-radius:clamp(38px,7vw,96px);background:var(--black);color:var(--white);display:flex;flex-direction:column;justify-content:flex-end;align-items:center;text-align:center;padding:clamp(2rem,6vw,5rem);box-shadow:0 28px 70px rgba(0,0,0,.14);overflow:hidden}.eyebrow,.kicker{font-family:var(--mono);font-size:.68rem;letter-spacing:.3em;text-transform:uppercase;color:var(--muted);margin-bottom:1rem}.hero .eyebrow{color:rgba(255,255,255,.7)}.hero h1{font-family:var(--serif-display);font-weight:200;font-size:clamp(5rem,18vw,13.5rem);letter-spacing:.28em;line-height:.82;color:var(--white);position:relative;display:inline-block;margin-bottom:clamp(6rem,15vh,12rem);text-indent:.28em}.hero h1 .halo-ring{position:absolute;top:.18em;right:-.42em;width:.72em;height:.22em;border:clamp(2px,.5vw,5px) solid currentColor;border-radius:50%;opacity:.9;transform:rotate(-18deg)}.hero .subtitle{font-family:var(--mono);font-weight:400;font-style:normal;font-size:clamp(1rem,2vw,1.45rem);letter-spacing:.34em;color:rgba(255,255,255,.92);margin-top:0}.hero .subtitle b{font-weight:800;color:var(--white)}.hero .tagline{font-family:var(--mono);font-size:.72rem;letter-spacing:.28em;text-transform:uppercase;color:rgba(255,255,255,.84);margin-top:1.5rem}.lede{color:rgba(255,255,255,.72);max-width:56ch;margin:1.8rem auto 0;font-size:1.03rem}.hero-ctas{display:flex;gap:.9rem;margin-top:2rem;flex-wrap:wrap;justify-content:center}.btn{display:inline-block;font-family:var(--mono);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;text-decoration:none;padding:.9rem 1.25rem;border-radius:999px;transition:transform .12s,background .15s,border-color .15s;border:0;cursor:pointer}.btn:active{transform:translateY(1px)}.btn-primary{background:var(--white);color:var(--black);font-weight:700}.btn-primary:hover{background:#eee}.btn-ghost{border:1px solid rgba(255,255,255,.4);color:var(--white);background:transparent}.btn-ghost:hover{border-color:var(--white)}.btn-ghost-dark{border:1px solid rgba(0,0,0,.28);color:var(--ink);background:transparent}.btn:disabled{opacity:.48;cursor:not-allowed}.hero .experience{width:100%;max-width:860px;margin:1rem auto 0}
.acronym{background:var(--white);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.acronym-inner{max-width:1120px;margin:0 auto;padding:2.2rem 1.5rem;display:flex;justify-content:center;gap:clamp(1.2rem,4vw,3.5rem);flex-wrap:wrap}.acronym span{font-family:var(--mono);font-size:clamp(.78rem,1.6vw,1rem);color:var(--ink);letter-spacing:.3em;text-transform:uppercase}.acronym b{color:var(--black);font-weight:700}
.paper{background:var(--white);color:var(--ink)}.paper-shade,.origin{background:var(--smoke)}.section{max-width:1120px;margin:0 auto;padding:5.5rem 1.5rem}.section h2{font-family:var(--serif-display);font-weight:300;font-size:clamp(2.1rem,5vw,4.2rem);line-height:1.02;max-width:18ch;letter-spacing:.02em}.section .intro{max-width:62ch;margin-top:1.2rem;color:var(--ink-soft);font-size:1.05rem}
.lives{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-top:3rem}@media(max-width:760px){.lives{grid-template-columns:1fr}}.life{border-radius:24px;padding:2rem 1.9rem}.life h3{font-family:var(--serif-display);font-size:1.35rem;font-weight:300;margin-bottom:1.1rem;letter-spacing:.08em}.life ul{list-style:none}.life li{padding:.55rem 0;border-bottom:1px solid rgba(0,0,0,.07);font-size:1rem}.life li:last-child{border-bottom:none}.life-trying{background:var(--paper-shade);color:var(--ink-soft)}.life-decided{background:var(--black);color:var(--white)}.life-decided li{border-bottom-color:rgba(255,255,255,.16)}.life-decided .mark{color:var(--white)}.life .mark{display:inline-block;width:1.4em;font-family:var(--mono)}
.rules-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem;margin-top:3rem}@media(max-width:760px){.rules-grid{grid-template-columns:1fr}}.rule-card{position:relative;background:#fff;border:1px solid var(--line);border-radius:24px;padding:1.7rem 1.6rem 1.9rem;box-shadow:none;overflow:hidden}.rule-card::before{content:"";position:absolute;left:1.6rem;right:1.6rem;top:3rem;height:1px;background:var(--black);opacity:.26}.rule-num{font-family:var(--mono);font-size:.65rem;letter-spacing:.28em;color:var(--muted);text-transform:uppercase}.rule-card h3{font-family:var(--serif-display);font-size:1.65rem;font-weight:300;color:var(--ink);margin-top:1.45rem}.rule-card p{color:var(--ink-soft);font-size:.97rem;margin-top:.5rem}
.path{border-left:1px solid var(--black);margin:3rem 0 0 .4rem;padding-left:2rem;display:grid;gap:2.4rem}.step{position:relative}.step::before{content:"";position:absolute;left:calc(-2rem - 6px);top:.4em;width:10px;height:10px;border-radius:50%;background:var(--black);box-shadow:0 0 0 4px var(--paper)}.step .when,.inside .tag{font-family:var(--mono);font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}.step h3{font-family:var(--serif-display);font-size:1.3rem;font-weight:300;margin-top:.3rem}.step p{color:var(--ink-soft);max-width:56ch;margin-top:.35rem;font-size:.98rem}
.inside-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-top:3rem}@media(max-width:860px){.inside-grid{grid-template-columns:1fr}}.inside{border-top:1px solid var(--black);background:#fff;border-radius:0;padding:1.7rem 0;border-left:0;border-right:0;border-bottom:1px solid var(--line)}.inside h3{font-family:var(--serif-display);font-size:1.2rem;font-weight:300;letter-spacing:.05em}.inside p{color:var(--ink-soft);font-size:.95rem;margin-top:.55rem}.inside .tag{display:block;margin-bottom:.7rem}
.origin-quote{font-family:var(--serif-display);font-style:normal;font-weight:300;font-size:clamp(1.7rem,4vw,3.6rem);line-height:1.08;max-width:18ch;color:var(--ink)}.origin-attr{margin-top:1.6rem;font-family:var(--mono);font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-soft)}.origin-body{max-width:58ch;margin-top:1.6rem;color:var(--ink-soft)}
.epigraph{background:var(--black);color:var(--white);text-align:center}.epigraph .section{padding:5rem 1.5rem}.epigraph p{font-family:var(--serif-display);font-style:normal;font-weight:200;font-size:clamp(2rem,5vw,4.5rem);line-height:1.08;letter-spacing:.08em}.epigraph .attr{font-family:var(--mono);font-size:.68rem;letter-spacing:.28em;text-transform:uppercase;color:rgba(255,255,255,.68);margin-top:1.4rem}
.author-grid{display:grid;grid-template-columns:auto 1fr;gap:2.5rem;align-items:start;margin-top:2.6rem}@media(max-width:700px){.author-grid{grid-template-columns:1fr}}.author-mark{width:110px;height:110px;border-radius:50%;background:var(--black);color:var(--white);display:flex;align-items:center;justify-content:center;font-family:var(--serif-display);font-size:1.2rem;font-weight:300;letter-spacing:.28em}.author-grid p{max-width:62ch;color:var(--ink-soft)}.author-grid p+p{margin-top:1rem}
.waitlist{background:var(--black);color:var(--white)}.final-cta{text-align:center}.final-cta h2{margin:0 auto;color:var(--white)}.final-cta .hero-ctas{justify-content:center}
footer{background:var(--black);border-top:1px solid rgba(255,255,255,.14)}.footer-inner{max-width:1120px;margin:0 auto;padding:2.2rem 1.5rem;display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}.footer-inner p{font-family:var(--mono);font-size:.68rem;letter-spacing:.12em;color:rgba(255,255,255,.52)}.footer-inner .fm{color:rgba(255,255,255,.84);font-family:var(--serif-display);font-weight:200;letter-spacing:.55em}
.reveal{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s ease}.reveal.in{opacity:1;transform:none}@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}}
</style>
</head>
<body>
<nav aria-label="Main">
  <div class="nav-inner">
    <a class="wordmark" href="#top">H<span style="position:relative">A<span class="ring" aria-hidden="true"></span></span>LO</a>
    <ul class="nav-links">
      <li><a href="#try">Try 1 • 60 • 7</a></li>
      <li><a href="#method">The Method</a></li>
      <li><a href="#app">HALO NOW</a></li>
      <li><a href="#origin">Origin</a></li>
      <li><a href="/app/">Open App</a></li>
      <li><a href="#try" class="nav-cta">Try HALO Now</a></li>
    </ul>
  </div>
</nav>

<header class="hero" id="top">
  <div>
    <p class="eyebrow">THE 1 • 60 • 7 TEST</p>
    <h1>H<span style="position:relative">A<span class="halo-ring" aria-hidden="true"></span></span>LO</h1>
    <p class="subtitle"><b>H</b>appen <b>A</b>lready. <b>L</b>ive <b>O</b>n.</p>
    <p class="tagline">1 card. 60 seconds. 7 days.</p>
    <p class="lede">Stop trying to become the person you want to be. Decide who you are, prove it with one action in the next 60 seconds, then live from the decision for seven days.</p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="#try">Try HALO Now</a>
      <a class="btn btn-ghost" href="/1607/">Open the Test</a>
      <a class="btn btn-ghost" href="#method">See the Method</a>
    </div>
  </div>
  <Halo1607Experience compact={true} />
</header>

<div class="acronym" aria-label="What HALO stands for">
  <div class="acronym-inner"><span><b>H</b>appened</span><span><b>A</b>lready.</span><span><b>L</b>ive</span><span><b>O</b>n.</span></div>
</div>

<main>
<section class="paper" id="method">
  <div class="section">
    <p class="kicker reveal">The Problem</p>
    <h2 class="reveal">You do not need more negotiation. You need proof.</h2>
    <p class="intro reveal">Every morning the debate reopens: should I, can I, am I really the kind of person who does this? HALO closes the debate with a present-tense decision and one visible action.</p>
    <div class="lives">
      <div class="life life-trying reveal"><h3>The Trying Life</h3><ul><li><span class="mark">&times;</span>Constant restarts</li><li><span class="mark">&times;</span>Future-tense promises</li><li><span class="mark">&times;</span>Every choice relitigated</li><li><span class="mark">&times;</span>Energy spent on the inner debate</li></ul></div>
      <div class="life life-decided reveal"><h3>The Decided Life</h3><ul><li><span class="mark">&check;</span>Present tense: I am</li><li><span class="mark">&check;</span>One action creates evidence</li><li><span class="mark">&check;</span>Slips become noise, not verdicts</li><li><span class="mark">&check;</span>The next action is clearer</li></ul></div>
    </div>
  </div>
</section>

<section class="paper paper-shade">
  <div class="section">
    <p class="kicker reveal">The Method</p>
    <h2 class="reveal">Four rules. One card. Written by hand.</h2>
    <p class="intro reveal">HALO is not affirmations, and it is not manifestation. It is a conduct system: a decision made once, backed by immediate action, protected from renegotiation.</p>
    <div class="rules-grid">
      <div class="rule-card reveal"><span class="rule-num">Rule 01</span><h3>Choose now.</h3><p>Name the identity in the present tense. Not a goal, not a wish.</p></div>
      <div class="rule-card reveal"><span class="rule-num">Rule 02</span><h3>Prove it through action.</h3><p>Take one aligned action within sixty seconds. Every aligned action adds evidence.</p></div>
      <div class="rule-card reveal"><span class="rule-num">Rule 03</span><h3>Stop negotiating.</h3><p>The question is no longer whether you are this person. It is what this person does next.</p></div>
      <div class="rule-card reveal"><span class="rule-num">Rule 04</span><h3>Reset quickly.</h3><p>A slip is a single event. Return at the next opportunity and the signal holds.</p></div>
    </div>
  </div>
</section>

<section class="paper" id="app">
  <div class="section">
    <p class="kicker reveal">HALO NOW</p>
    <h2 class="reveal">Take HALO with you.</h2>
    <p class="intro reveal">The app keeps the decision visible, captures proof, tracks your return after slips, and carries 1 • 60 • 7 into the 90-Day Build.</p>
    <div class="inside-grid">
      <div class="inside reveal"><span class="tag">Today</span><h3>Your card and next proof</h3><p>Keep the identity and immediate action where you can see them.</p></div>
      <div class="inside reveal"><span class="tag">Evidence</span><h3>What you actually did</h3><p>Record observable proof instead of relying on motivation.</p></div>
      <div class="inside reveal"><span class="tag">Reset</span><h3>Return quickly</h3><p>Recover after slips without turning one miss into a story.</p></div>
    </div>
    <div class="path"><div class="step reveal"><span class="when">7 days</span><h3>The first test</h3><p>Live from the decision long enough to gather real evidence.</p></div><div class="step reveal"><span class="when">90 days</span><h3>The build</h3><p>The decision moves from event to default through repetition.</p></div></div>
  </div>
</section>

<section class="paper paper-shade" id="inside">
  <div class="section">
    <p class="kicker reveal">The Book</p>
    <h2 class="reveal">The test lets you experience HALO. The book explains why it works.</h2>
    <p class="intro reveal">HALO Identity for Lasting Change explains why identity changes the behavior underneath goals and habits, and how to make the change durable.</p>
    <div class="inside-grid">
      <div class="inside reveal"><span class="tag">Method</span><h3>Happened Already. Live On.</h3><p>The four rules and the card that make the decision concrete.</p></div>
      <div class="inside reveal"><span class="tag">Mechanism</span><h3>Identity before behavior</h3><p>Why the person performing the habit matters more than the habit alone.</p></div>
      <div class="inside reveal"><span class="tag">Practice</span><h3>7 days to 90 days</h3><p>How to move from first proof into a durable default.</p></div>
    </div>
  </div>
</section>

<section class="epigraph"><div class="section"><p class="reveal">&ldquo;What you settle repeats.<br>What repeats compounds.&rdquo;</p><p class="attr reveal">The premise of HALO</p></div></section>

<section class="origin paper" id="origin"><div class="section"><p class="kicker reveal">The Origin</p><p class="origin-quote reveal">It began with a single sentence, spoken by a gym class instructor in Manhattan.</p><p class="origin-attr reveal">For Patricia, who planted the seed</p><p class="origin-body reveal">Patricia Moreno saw something most people could not see, and she said it in a way that could not be forgotten. Gordon Ebanks spent the next two decades testing what she showed him: decide first, prove it now, live from there.</p></div></section>

<section class="paper" id="author"><div class="section"><p class="kicker reveal">The Author</p><h2 class="reveal">Gordon Ebanks</h2><div class="author-grid"><div class="author-mark reveal" aria-hidden="true">GE</div><div class="reveal"><p>Born and raised in England, Gordon has built businesses across industries and spent two decades testing the identity-first method on himself and the people around him.</p><p>HALO is the field report.</p></div></div></div></section>

<section class="waitlist" id="final"><div class="section final-cta"><p class="kicker reveal">Try HALO Now</p><h2 class="reveal">One card. One action. Seven days.</h2><div class="hero-ctas reveal"><a class="btn btn-primary" href="#try">Take the 1 • 60 • 7 Test</a><a class="btn btn-ghost" href="/1607/">Open the Test</a><a class="btn btn-ghost" href="#inside">Get HALO at launch</a></div></div></section>
</main>

<footer><div class="footer-inner"><p class="fm">HALO</p><p>&copy; 2026 Install Once &middot; installonce.ai &middot; All rights reserved</p></div></footer>

<script>
(() => {
  const els = document.querySelectorAll(".reveal");
  if (!("IntersectionObserver" in window)) { els.forEach((el) => el.classList.add("in")); return; }
  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("in");
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });
  els.forEach((el) => io.observe(el));
})();
</script>
</body>
</html>
