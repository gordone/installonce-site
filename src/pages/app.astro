<script is:inline>
var STORAGE_KEY = 'halo.now.1607.state.v1';
function defaultState(){
  return {
    identity:"a healthy person.",
    firstProof:"Walk for sixty seconds.",
    minimum:"Put on walking shoes.",
    resetRule:"Stand up and take one breath.",
    reviewDate:"Day 90 review",
    onboarded:false,
    day:1,
    days:Array(30).fill(0),
    proofs:{},
    negotiation:{},
    dailyAdjustments:{},
    slips:[],
    selectedNegotiation:"Low"
  };
}
var state = defaultState();

function valueOr(id, fallback){
  var el = document.getElementById(id);
  return el && el.value.trim() ? el.value.trim() : fallback;
}

function setText(id, value){
  var el = document.getElementById(id);
  if (el) el.textContent = value;
}
function saveState(){
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ state: state, caps: caps })); } catch (error) {}
}
function restoreState(){
  try {
    var raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return;
    var saved = JSON.parse(raw);
    if (saved && saved.state) state = Object.assign(defaultState(), saved.state);
    if (!Array.isArray(state.days) || state.days.length !== 30) state.days = Array(30).fill(0);
    state.proofs = state.proofs || {};
    state.negotiation = state.negotiation || {};
    state.dailyAdjustments = state.dailyAdjustments || {};
    state.slips = Array.isArray(state.slips) ? state.slips : [];
    state.selectedNegotiation = state.selectedNegotiation || 'Low';
    caps = saved && saved.caps && typeof saved.caps === 'object' ? saved.caps : {};
  } catch (error) {
    state = defaultState();
    caps = {};
  }
}
function hydrateFromState(){
  var onboard = document.getElementById('onboard');
  if (state.onboarded && onboard) onboard.classList.add('hidden');
  setText('cardIdentity', state.identity);
  setText('todayProof', state.firstProof);
  setText('todayMinimum', state.minimum);
  var d = new Date();
  setText('todayDate', d.toLocaleDateString('en-US',{weekday:'long', month:'long', day:'numeric'}));
  var proof = document.getElementById('obProof'); if (proof) proof.value = state.firstProof;
  var minimum = document.getElementById('obMinimum'); if (minimum) minimum.value = state.minimum;
  var reset = document.getElementById('obReset'); if (reset) reset.value = state.resetRule;
  var review = document.getElementById('obReview'); if (review) review.value = state.reviewDate;
  var identity = document.getElementById('obIdentity'); if (identity) identity.value = state.identity;
  document.querySelectorAll('[data-neg]').forEach(function(btn){ btn.classList.toggle('active', btn.dataset.neg === state.selectedNegotiation); });
}
function resetTest(){
  if (!confirm('Reset this local 1 • 60 • 7 test on this device?')) return;
  try { localStorage.removeItem(STORAGE_KEY); } catch (error) {}
  state = defaultState();
  caps = {};
  location.reload();
}

document.querySelectorAll('.chip').forEach(function(c){
  c.addEventListener('click', function(){
    document.getElementById('obIdentity').value = c.dataset.id;
    document.getElementById('obProof').value = c.dataset.proof || '';
    document.getElementById('obMinimum').value = c.dataset.min || '';
    document.getElementById('obReset').value = c.dataset.reset || '';
  });
});

document.querySelectorAll('[data-neg]').forEach(function(btn){
  btn.addEventListener('click', function(){
    document.querySelectorAll('[data-neg]').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    state.selectedNegotiation = btn.dataset.neg;
    saveState();
  });
});

function obNext(){
  var identity = document.getElementById('obIdentity').value.trim();
  var proof = document.getElementById('obProof').value.trim();
  var error = document.getElementById('obError');
  if (!identity || !proof) {
    error.classList.add('visible');
    document.getElementById(!identity ? 'obIdentity' : 'obProof').focus();
    return;
  }
  error.classList.remove('visible');
  state.identity = identity;
  state.firstProof = proof;
  state.minimum = valueOr('obMinimum', state.minimum);
  state.resetRule = valueOr('obReset', state.resetRule);
  state.reviewDate = valueOr('obReview', state.reviewDate);
  saveState();
  document.getElementById('ob1').classList.remove('active');
  document.getElementById('ob2').classList.add('active');
  setText('obActionText', state.firstProof);
  runRing('obRing','obNum',60);
}
function obDone(){
  clearInterval(ringTimers.obRing);
  setText('obNum', 'done');
  document.getElementById('ob2').classList.remove('active');
  document.getElementById('ob3').classList.add('active');
  setText('obSummary', 'I am ' + state.identity + ' - declared, and backed by one act inside the first minute.');
  setText('obProtocol', 'Minimum: ' + state.minimum + ' Reset: ' + state.resetRule + ' Review: ' + state.reviewDate + '.');
}
function enterApp(){
  state.onboarded = true;
  document.getElementById('onboard').classList.add('hidden');
  setText('cardIdentity', state.identity);
  setText('todayProof', state.firstProof);
  setText('todayMinimum', state.minimum);
  var d = new Date();
  setText('todayDate', d.toLocaleDateString('en-US',{weekday:'long', month:'long', day:'numeric'}));
  updateStatus();
  saveState();
}

var ringTimers = {};
function runRing(ringId, numId, secs){
  var ring = document.getElementById(ringId), num = document.getElementById(numId);
  var total = 414.7, t = secs;
  clearInterval(ringTimers[ringId]);
  num.textContent = t;
  ring.style.strokeDashoffset = 0;
  ringTimers[ringId] = setInterval(function(){
    t--;
    if (t < 0) { clearInterval(ringTimers[ringId]); num.textContent = 'done'; return; }
    num.textContent = t;
    ring.style.strokeDashoffset = total * (1 - t/secs);
  }, 1000);
}
function startSixty(){
  var proof = document.getElementById('proofInput').value.trim();
  var error = document.getElementById('proofError');
  if (!proof) {
    error.classList.add('visible');
    document.getElementById('proofInput').focus();
    return;
  }
  error.classList.remove('visible');
  document.getElementById('sixtyWrap').style.display = 'block';
  document.getElementById('btnSixty').style.display = 'none';
  runRing('dayRing','dayNum',60);
}
function stopSixty(){
  clearInterval(ringTimers.dayRing);
  setText('dayNum', 'done');
}

function logDay(kind){
  var proof = document.getElementById('proofInput').value.trim();
  var error = document.getElementById('proofError');
  if (!proof && kind === 1) {
    error.classList.add('visible');
    document.getElementById('proofInput').focus();
    return;
  }
  error.classList.remove('visible');
  var idx = state.day - 1;
  if (idx >= 0 && idx < 30) state.days[idx] = kind;
  if (!proof && kind === 2) proof = state.resetRule;
  state.proofs[state.day] = proof;
  state.negotiation[state.day] = state.selectedNegotiation;
  state.dailyAdjustments[state.day] = buildDailyAdjustment(kind, proof, state.selectedNegotiation);
  if (kind === 2) {
    state.slips.push({ day: state.day, acknowledgedAt: Date.now() - 45000, resetAt: Date.now(), action: proof });
  }
  state.day = Math.min(state.day + 1, 30);
  saveState();
  document.getElementById('proofInput').value = '';
  updateStatus(); renderEvidence(); renderBase();
  go('evidence', document.querySelector('[data-scr="evidence"]'));
}
function phaseLabel(){
  var d = state.day;
  if (d <= 7) return 'Test';
  if (d <= 30) return 'Quiet';
  return 'Build';
}
function updateStatus(){
  var d = state.day;
  var phase = d <= 7 ? '1 • 60 • 7' : d <= 30 ? 'THE QUIET STRETCH' : 'THE 90-DAY BUILD';
  setText('statusDay', 'DAY ' + d + ' - ' + phase);
  var done = state.days.filter(function(x){return x===1}).length;
  var chip = document.getElementById('signalChip');
  chip.textContent = d <= 7 ? ('1 • 60 • 7 - Day ' + d + ' of 7')
    : (done + ' aligned days - HALO NOW is running');
}
function averageReturnSpeed(){
  if (!state.slips.length) return '-';
  var mins = state.slips.map(function(s){ return Math.max(1, Math.round((s.resetAt - s.acknowledgedAt) / 60000)); });
  var avg = Math.round(mins.reduce(function(a,b){return a+b;},0) / mins.length);
  return avg + 'm';
}
function recentNegotiationDays(count){
  var start = Math.max(1, state.day - count);
  return Object.keys(state.negotiation)
    .filter(function(day){ return Number(day) >= start && Number(day) < state.day; })
    .map(function(day){ return state.negotiation[day]; });
}
function proofLooksConcrete(proof){
  return /\b(sent|called|walked|wrote|opened|moved|paid|scheduled|emailed|texted|read|cleaned|asked|reviewed|logged|finished|started)\b/i.test(proof)
    || proof.trim().split(/\s+/).length >= 4;
}
function buildDailyAdjustment(kind, proof, negotiation){
  var heavyRecently = recentNegotiationDays(2).filter(function(v){ return v === 'Heavy'; }).length;
  if (kind === 2) {
    return {
      title:'Protect the return.',
      body:'The reset is data, not a verdict. Tomorrow should use the hard-day minimum exactly as written.',
      next:'Next: ' + state.minimum
    };
  }
  if (!proofLooksConcrete(proof)) {
    return {
      title:'Make proof more observable.',
      body:'The identity is easier to live when the proof can be seen or counted.',
      next:'Next: rewrite tomorrow as one visible action.'
    };
  }
  if (negotiation === 'Heavy' || heavyRecently >= 2) {
    return {
      title:'Shrink tomorrow.',
      body:'You completed the proof, but resistance is high. Keep the identity and lower the action size.',
      next:'Next: use the hard-day minimum before adding anything.'
    };
  }
  if (negotiation === 'Some') {
    return {
      title:'Repeat before you raise.',
      body:'Some negotiation means the proof is working, but it is not automatic yet.',
      next:'Next: repeat the same action once more.'
    };
  }
  return {
    title:'Hold the line.',
    body:'Low negotiation plus proof means the action is sized correctly. Do not improve it yet.',
    next:'Next: repeat exactly tomorrow.'
  };
}
function latestAdjustment(){
  var days = Object.keys(state.dailyAdjustments).map(Number).sort(function(a,b){ return b - a; });
  return days.length ? state.dailyAdjustments[days[0]] : null;
}
function renderDailyCoach(){
  var adjustment = latestAdjustment() || {
    title:'Keep the entry tiny.',
    body:'One proof line is enough. The app will tune tomorrow from what you log today.',
    next:'Next: make the action observable.'
  };
  setText('coachTitle', adjustment.title);
  setText('coachBody', adjustment.body);
  setText('coachNext', adjustment.next);
  setText('evidenceCoachTitle', adjustment.title);
  setText('evidenceCoachBody', adjustment.body);
  setText('evidenceCoachNext', adjustment.next);
}
function setBar(id, percent){
  var el = document.getElementById(id);
  if (el) el.style.width = Math.max(0, Math.min(100, percent)) + '%';
}
function renderSevenDayReport(){
  var firstSeven = state.days.slice(0,7);
  var proofDays = firstSeven.filter(function(x){ return x === 1; }).length;
  var resetDays = firstSeven.filter(function(x){ return x === 2; }).length;
  var loggedDays = proofDays + resetDays;
  var heavyDays = Object.keys(state.negotiation)
    .filter(function(day){ return Number(day) <= 7; })
    .filter(function(day){ return state.negotiation[day] === 'Heavy'; }).length;
  var shrinkDays = Object.keys(state.dailyAdjustments)
    .filter(function(day){ return Number(day) <= 7; })
    .filter(function(day){ return /shrink/i.test(state.dailyAdjustments[day].title); }).length;
  var proofScore = Math.round(proofDays / 7 * 100);
  var returnScore = loggedDays ? Math.round((proofDays + resetDays * .65) / 7 * 100) : 0;
  var resistanceScore = Math.max(0, Math.round(100 - heavyDays / 7 * 100));
  var score = Math.round(proofScore * .55 + returnScore * .3 + resistanceScore * .15);
  var title = loggedDays < 7 ? 'Building the signal' : score >= 82 ? 'Strong signal' : score >= 58 ? 'Useful pattern' : 'Shrink the action';
  var insight = loggedDays < 7
    ? loggedDays + ' of 7 days logged. Keep the entry to one proof line so the diagnostic has enough signal.'
    : proofDays + ' proof days, ' + resetDays + ' reset days, and ' + heavyDays + ' heavy-negotiation days. The pattern is now visible.';
  if (loggedDays >= 7 && shrinkDays) {
    insight += ' HALO recommended shrinking the action ' + shrinkDays + ' time' + (shrinkDays > 1 ? 's' : '') + ' to keep the trajectory alive.';
  }
  var next = loggedDays < 7
    ? 'Next: complete today with one observable line.'
    : score >= 82
      ? 'Next: extend the identity into the 30-day quiet stretch.'
      : score >= 58
        ? 'Next: keep the identity, but fine-tune the hard-day minimum.'
        : 'Next: make the action smaller until it can survive a difficult day.';
  setText('reportScore', String(score));
  setText('reportTitle', title);
  setText('proofMetric', proofDays + '/7');
  setText('returnMetric', resetDays ? resetDays + ' reset' + (resetDays > 1 ? 's' : '') : 'clean');
  setText('resistanceMetric', heavyDays ? heavyDays + ' heavy' : 'low');
  setText('reportInsight', insight);
  setText('reportNext', next);
  setBar('proofBar', proofScore);
  setBar('returnBar', returnScore);
  setBar('resistanceBar', resistanceScore);
}

function renderEvidence(){
  var g = document.getElementById('evGrid'); g.innerHTML = '';
  state.days.forEach(function(v,i){
    var c = document.createElement('div');
    c.className = 'ev-cell' + (v===1?' done':v===2?' slip':'');
    c.textContent = v===1 ? (i+1)+' yes' : v===2 ? (i+1)+' reset' : String(i+1);
    c.onclick = function(){ state.days[i] = (state.days[i]+1)%3; saveState(); renderEvidence(); renderBase(); };
    g.appendChild(c);
  });
  var done = state.days.filter(function(x){return x===1}).length;
  var slips = state.days.filter(function(x){return x===2}).length;
  var logged = done + slips;
  var conductRate = logged ? Math.round(done / logged * 100) : 0;
  setText('evCount', done + ' / 30');
  setText('conductRate', conductRate + '%');
  setText('returnSpeed', averageReturnSpeed());
  setText('phaseName', phaseLabel());
  document.getElementById('evBar').style.width = (done/30*100)+'%';
  var t = document.getElementById('signalTimeline'); t.innerHTML = '';
  state.days.slice(0,14).forEach(function(v,i){
    var dot = document.createElement('span');
    dot.className = v===1 ? 'done' : v===2 ? 'slip' : '';
    dot.textContent = i + 1;
    t.appendChild(dot);
  });
  var v = '';
  if (done===0 && slips===0) v = 'Day one is small on purpose. You are recruiting proof, not impressing anyone.';
  else if (done>0 && done<7) v = done + ' of 30 - noise until seven. Keep voting.';
  else if (done>=7 && slips===0) v = 'Seven or more, no slips. That is signal.';
  else if (slips>0 && done>=slips) v = slips + ' slip' + (slips>1?'s':'') + ', reset each time. The signal holds.';
  else if (slips>done) v = 'More slips than aligned days - protect the return before making a verdict.';
  if (done>=30) v = 'Thirty days of signal. The default has taken root.';
  setText('evVerdict', v);
  renderSevenDayReport();
  renderDailyCoach();
  var log = document.getElementById('proofLog'); log.innerHTML = '';
  Object.keys(state.proofs).slice(-3).reverse().forEach(function(day){
    var item = document.createElement('article');
    item.innerHTML = '<strong>Day '+day+': '+state.proofs[day]+'</strong><span>Negotiation: '+(state.negotiation[day] || 'Low')+'</span>';
    log.appendChild(item);
  });
}

var domains = [
  {d:'Body', bg:'#E1F5EE'}, {d:'Wealth', bg:'#FBF4E8'},
  {d:'Relationships', bg:'#FBEAF0'}, {d:'Career', bg:'#EAF0FB'},
  {d:'Home', bg:'#EBF5EB'}, {d:'Growth', bg:'#FBF0E8'}
];
var caps = {};
restoreState();
function renderBoard(){
  var g = document.getElementById('boardGrid'); g.innerHTML='';
  domains.forEach(function(o){
    var c = document.createElement('div');
    c.className = 'bcell'; c.style.background = o.bg;
    c.innerHTML = '<span class="dom">'+o.d+'</span>' +
      (caps[o.d] ? '<span class="cap">'+caps[o.d]+'</span>' : '<span class="add">[ tap to caption ]</span>');
    c.onclick = function(){
      var v = prompt('Caption for ' + o.d + ' - what does the Decided Life look like here?', caps[o.d]||'');
      if (v !== null) { caps[o.d] = v.trim(); saveState(); renderBoard(); }
    };
    g.appendChild(c);
  });
  var w = document.createElement('div');
  w.className = 'bcell bword';
  w.innerHTML = '<span class="dom">My word</span><input placeholder="one word for this life" maxlength="24">';
  g.appendChild(w);
}
function renderBase(){
  var done = state.days.filter(function(x){return x===1}).length;
  setText('baseIdentity', 'I am ' + state.identity);
  setText('baseProof', state.firstProof);
  setText('baseProofCount', String(done));
  setText('baseReturnSpeed', averageReturnSpeed());
  setText('baseReview', state.reviewDate.replace(' review',''));
  setText('baseReset', state.resetRule);
  var strips = document.querySelectorAll('.phase-strip span');
  strips.forEach(function(s,i){ s.classList.toggle('on', i < Math.min(state.day, 7)); });
}
function showTool(name){
  var messages = {
    worksheet:'The 1-card step is already merged into onboarding: identity, first proof, hard-day minimum, reset rule, and review date.',
    signal:'The 60-second proof gives the decision evidence before motivation can turn it into a debate.',
    audit:'The 7-day test unlocks the first useful verdict: whether the identity fits when lived, not imagined.',
    integrity:'The 90-Day Build moves the decision from first proof into a durable default.'
  };
  alert(messages[name]);
}

function go(name, btn){
  document.querySelectorAll('.screen').forEach(function(s){ s.classList.remove('active'); });
  document.getElementById('scr-'+name).classList.add('active');
  document.querySelectorAll('.tab').forEach(function(t){ t.classList.remove('active'); });
  if (btn) btn.classList.add('active');
  document.querySelector('.screens').scrollTop = 0;
  renderBase();
}

hydrateFromState(); renderEvidence(); renderBoard(); renderBase(); updateStatus();
</script>
</body>
</html>
