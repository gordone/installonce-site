---
const appTitle = 'HALO NOW - 1 • 60 • 7';
---
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{appTitle}</title>
<meta name="description" content="Run the 1 • 60 • 7 Test in HALO NOW: one card, one action in sixty seconds, and seven days living from the decision.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Caveat:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{
  --black:#010101; --charcoal:#101010; --white:#fff; --smoke:#f6f6f1; --line:#e7e7e0;
  --evergreen:#010101; --evergreen-deep:#010101; --teal:#111; --teal-bright:#fff;
  --paper:#fff; --paper-shade:#f6f6f1; --card-rule:#d8d8d8; --headrule:#111;
  --ink:#0c0c0c; --ink-soft:#616161; --pen:#111; --slip:#8a8a8a; --slip-bg:#ededed;
  --display:Inter,Arial,sans-serif; --body:'Source Serif 4',Georgia,serif;
  --hand:'Caveat',cursive; --mono:ui-monospace,'SF Mono',Menlo,monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--white);font-family:var(--body);display:flex;align-items:center;justify-content:center;min-height:100vh;padding:1.5rem;color:var(--ink)}
button,input,textarea{font:inherit}
button{cursor:pointer}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}

.phone{width:390px;max-width:100%;height:820px;max-height:94vh;background:var(--black);border-radius:42px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 38px 90px rgba(0,0,0,.24),0 0 0 10px var(--black);position:relative}
@media(max-width:430px){body{padding:0}.phone{height:100vh;max-height:none;border-radius:0;box-shadow:none}}

.status{background:var(--black);color:var(--paper);padding:1rem 1.3rem .85rem;display:flex;justify-content:space-between;align-items:center;font-family:var(--mono);font-size:.62rem;letter-spacing:.18em;border-bottom:1px solid rgba(255,255,255,.12)}
.status .brand{font-family:var(--display);font-weight:300;letter-spacing:.42em;font-size:.8rem;position:relative}
.status .brand i{position:absolute;top:-.36em;left:.54em;width:.78em;height:.28em;border:1.25px solid var(--teal-bright);border-radius:50%;font-style:normal;transform:rotate(-8deg)}

.screens{flex:1;overflow-y:auto;background:var(--white)}
.screen{display:none;padding:1.3rem 1.3rem 2rem;animation:fadein .3s ease}
.screen.active{display:block}
@keyframes fadein{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

.day-label{font-family:var(--mono);font-size:.62rem;letter-spacing:.24em;text-transform:uppercase;color:var(--ink-soft)}
h1.today{font-family:var(--display);font-weight:250;font-size:1.95rem;color:var(--ink);line-height:1.05;margin-top:.25rem;letter-spacing:.03em}
.signal-chip{display:inline-flex;align-items:center;gap:.45rem;margin-top:.8rem;font-family:var(--mono);font-size:.58rem;letter-spacing:.16em;text-transform:uppercase;color:var(--white);background:var(--black);border-radius:999px;padding:.42rem .85rem}
.signal-chip::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--white)}

.icard{position:relative;background:#fff;border:1px solid var(--line);border-radius:24px;box-shadow:none;padding:1.1rem 1.2rem;overflow:hidden;margin-top:1.2rem}
.icard::before{content:"";position:absolute;left:1.2rem;right:1.2rem;top:2.15rem;height:1px;background:var(--headrule);opacity:.28}
.icard .lbl{position:relative;z-index:2;font-family:var(--mono);font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-soft)}
.icard .iam{position:relative;z-index:2;margin-top:1.7rem;font-size:1.05rem;color:var(--ink)}
.icard .iam .w{font-family:var(--hand);font-size:1.65rem;font-weight:600;color:var(--pen)}
.icard .q{position:relative;z-index:2;margin-top:1.5rem;font-family:var(--hand);font-size:1.5rem;font-weight:600;color:var(--pen);line-height:1.3}

.btn{display:block;width:100%;font-family:var(--mono);font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;font-weight:700;border:none;border-radius:999px;padding:1rem;cursor:pointer;text-align:center;transition:transform .1s,background .15s,border-color .15s;margin-top:1rem}
.btn:active{transform:translateY(1px)}
.btn-primary{background:var(--evergreen);color:var(--paper)}
.btn-primary:hover{background:#222}
.btn-slip{background:var(--slip-bg);color:var(--black);border:1px solid var(--line)}

.timer-wrap{text-align:center;padding:1rem 0 .4rem}
.timer-ring{width:150px;height:150px;margin:0 auto;position:relative}
.timer-ring svg{transform:rotate(-90deg)}
.timer-ring .num{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--display);font-weight:250;font-size:2.6rem;color:var(--evergreen)}
.timer-note{font-family:var(--mono);font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft);margin-top:.8rem}

.proof{margin-top:1.2rem}
.proof label{font-family:var(--mono);font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft);display:block;margin-bottom:.5rem}
.proof textarea{width:100%;font-family:var(--hand);font-size:1.35rem;font-weight:500;color:var(--pen);background:#fff;border:1.5px solid var(--line);border-radius:18px;padding:.8rem .9rem;resize:none;line-height:1.45}
.proof textarea:focus{outline:2px solid var(--teal);border-color:var(--teal)}
.field-grid{display:grid;gap:.75rem;margin-top:1.1rem}
.field-grid label{font-family:var(--mono);font-size:.58rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(252,251,247,.68);display:block;margin-bottom:.35rem}
.field-grid input{width:100%;border:1px solid rgba(252,251,247,.22);border-radius:8px;background:rgba(252,251,247,.09);color:var(--paper);padding:.72rem .8rem;outline:none}
.field-grid input::placeholder{color:rgba(252,251,247,.42)}
.field-grid input:focus{border-color:var(--teal-bright);box-shadow:0 0 0 2px rgba(46,156,124,.18)}
.form-error{display:none;margin-top:.7rem!important;color:#F2A3AA!important;font-family:var(--mono);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase}
.form-error.visible{display:block}
.mini-panel{margin-top:1rem;background:var(--paper-shade);border-radius:20px;padding:.9rem 1rem;color:var(--ink-soft);font-size:.88rem}
.mini-panel b{color:var(--teal)}
.coach-card{margin-top:1rem;background:var(--black);color:var(--white);border-radius:24px;padding:1rem;overflow:hidden}
.coach-card span{display:block;font-family:var(--mono);font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.58)}
.coach-card strong{display:block;margin-top:.45rem;font-family:var(--display);font-weight:300;font-size:1.15rem;line-height:1.12}
.coach-card p{margin-top:.55rem;color:rgba(255,255,255,.72);font-size:.9rem}
.coach-card i{display:block;margin-top:.75rem;border-top:1px solid rgba(255,255,255,.14);padding-top:.75rem;font-family:var(--mono);font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.68);font-style:normal}
.segmented{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:.6rem}
.segmented button{border:1px solid var(--line);background:#fff;border-radius:999px;padding:.7rem .35rem;font-family:var(--mono);font-size:.58rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft)}
.segmented button.active{border-color:var(--black);background:var(--black);color:var(--white);font-weight:700}

.ev-head{display:flex;justify-content:space-between;align-items:baseline;margin-top:1.4rem}
.ev-head h2{font-family:var(--display);font-weight:300;font-size:1.15rem}
.ev-count{font-family:var(--mono);font-size:.62rem;letter-spacing:.12em;color:var(--black)}
.ev-bar{height:6px;background:var(--paper-shade);border-radius:3px;margin-top:.7rem;overflow:hidden}
.ev-bar i{display:block;height:100%;background:var(--black);border-radius:3px;transition:width .4s}
.ev-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:7px;margin-top:1rem}
:global(.ev-cell){aspect-ratio:1;border-radius:14px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;cursor:pointer;background:#fff;transition:transform .1s;font-family:var(--mono);font-size:.58rem;color:var(--ink-soft);text-align:center}
:global(.ev-cell:active){transform:scale(.94)}
:global(.ev-cell.done){background:var(--black);border-color:var(--black);color:#fff}
:global(.ev-cell.slip){background:var(--slip-bg);border-color:var(--slip);color:var(--black)}
.ev-verdict{margin-top:1rem;font-size:.92rem;color:var(--ink-soft);min-height:1.4em}
.law{margin-top:1.2rem;background:var(--paper-shade);border-radius:10px;padding:.9rem 1.1rem;font-size:.85rem;color:var(--ink-soft)}
.law b{color:var(--teal)}
.treaty{margin-top:1rem;background:#fff;border:1.5px dashed #D8D3C6;border-radius:10px;padding:.9rem 1.1rem}
.treaty .t1{font-family:var(--mono);font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft)}
.treaty .t2{font-family:var(--hand);font-size:1.45rem;font-weight:600;color:var(--pen);margin-top:.3rem}
.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:1rem}
.metric{background:#fff;border:1px solid #E5E1D6;border-radius:10px;padding:.8rem .7rem}
.metric strong{display:block;font-family:var(--display);font-size:1.25rem;color:var(--evergreen)}
.metric span{display:block;font-family:var(--mono);font-size:.52rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);margin-top:.2rem}
.timeline{display:flex;align-items:center;gap:7px;margin-top:1rem}
:global(.timeline span){width:16px;height:16px;border-radius:50%;background:#D8D3C6;display:inline-flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:.48rem;color:var(--ink-soft)}
:global(.timeline span.done){background:var(--black);color:#fff}
:global(.timeline span.slip){background:var(--slip-bg);border:1px solid var(--slip);color:var(--black)}
.proof-log{display:grid;gap:.65rem;margin-top:1rem}
:global(.proof-log article){background:#fff;border:1px solid var(--line);border-radius:18px;padding:.8rem .9rem}
:global(.proof-log strong){display:block;color:var(--ink);font-size:.94rem}
:global(.proof-log span){display:block;color:var(--ink-soft);font-size:.78rem;margin-top:.25rem}
.diagnostic-card{margin-top:1.2rem;background:var(--black);color:var(--white);border-radius:28px;padding:1.15rem;overflow:hidden}
.diagnostic-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}
.diagnostic-head span{font-family:var(--mono);font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.56)}
.diagnostic-head strong{display:block;margin-top:.2rem;font-family:var(--display);font-weight:250;font-size:1.45rem;line-height:1.05}
.report-score{min-width:82px;text-align:right;font-family:var(--display);font-weight:250;font-size:2.4rem;line-height:1;color:var(--white)}
.report-score small{font-family:var(--mono);font-size:.62rem;color:rgba(255,255,255,.58)}
.report-bars{display:grid;gap:.75rem;margin-top:1rem}
.report-bars label{display:flex;justify-content:space-between;font-family:var(--mono);font-size:.56rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.62)}
.report-track{height:7px;border-radius:999px;background:rgba(255,255,255,.16);overflow:hidden}
.report-track i{display:block;height:100%;width:0;border-radius:999px;background:var(--white);transition:width .8s cubic-bezier(.2,.7,.2,1)}
.report-insight{margin-top:1rem;color:rgba(255,255,255,.74);font-size:.9rem}
.report-next{margin-top:.75rem;border-top:1px solid rgba(255,255,255,.14);padding-top:.75rem;font-family:var(--mono);font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.68)}

.board-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:1.2rem}
:global(.bcell){border-radius:20px;aspect-ratio:4/3;padding:.8rem .9rem;display:flex;flex-direction:column;justify-content:space-between;cursor:pointer;border:1px solid rgba(0,0,0,.05)}
:global(.bcell .dom){font-family:var(--mono);font-size:.58rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft)}
:global(.bcell .add){font-family:var(--mono);font-size:.62rem;color:var(--ink-soft);opacity:.7}
:global(.bcell .cap){font-family:var(--hand);font-size:1.15rem;font-weight:600;color:var(--pen);line-height:1.25}
:global(.bword){grid-column:span 2;aspect-ratio:auto;padding:1.1rem;background:#fff;border:1.5px dashed #D8D3C6;text-align:center}
:global(.bword input){border:none;background:transparent;width:100%;text-align:center;font-family:var(--hand);font-size:1.7rem;font-weight:600;color:var(--pen);outline:none}
:global(.bword input::placeholder){color:#B8B2A4}

.screen h2.sec{font-family:var(--display);font-weight:600;font-size:1.35rem;margin-top:.2rem;color:var(--ink)}
.sub{color:var(--ink-soft);font-size:.9rem;margin-top:.4rem}

.tabbar{display:flex;background:var(--black);border-top:1px solid rgba(255,255,255,.12)}
.tab{flex:1;background:none;border:none;color:rgba(252,251,247,.5);font-family:var(--mono);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;padding:.85rem 0 1.05rem;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:.3rem}
.tab svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.6}
.tab.active{color:var(--paper)}
.tab.active svg{stroke:var(--teal-bright)}

.onboard{position:absolute;inset:0;background:var(--black);color:var(--paper);z-index:20;display:flex;flex-direction:column;justify-content:center;padding:2rem 1.6rem;overflow-y:auto}
.onboard.hidden{display:none}
.ob-step{display:none}.ob-step.active{display:block;animation:fadein .35s ease}
.ob-kicker{font-family:var(--mono);font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:var(--teal-bright)}
.onboard h1{font-family:var(--display);font-weight:250;font-size:2.1rem;line-height:1.05;margin-top:.7rem;letter-spacing:.04em}
.onboard h1 b{font-weight:800}
.onboard .halo-phrase{font-family:var(--mono);font-size:.82rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(252,251,247,.9);margin-top:.9rem}
.onboard .halo-phrase b{font-weight:800;color:var(--paper)}
.onboard p{color:rgba(252,251,247,.75);margin-top:.9rem;font-size:.98rem;line-height:1.6}
.ob-card{background:var(--paper);border-radius:24px;padding:1.1rem 1.2rem;margin-top:1.5rem;position:relative;overflow:hidden}
.ob-card::before{content:"";position:absolute;left:0;right:0;top:2.1rem;height:2px;background:var(--headrule);opacity:.55}
.ob-card .lbl{font-family:var(--mono);font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-soft)}
.ob-card .row{margin-top:1.6rem;font-size:1.1rem;color:var(--ink);display:flex;align-items:baseline;gap:.4rem}
.ob-card input{flex:1;border:none;border-bottom:2px solid var(--teal);background:transparent;font-family:var(--hand);font-size:1.6rem;font-weight:600;color:var(--pen);outline:none;min-width:0}
.chips{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.1rem}
.chip{font-family:var(--mono);font-size:.62rem;letter-spacing:.08em;background:rgba(252,251,247,.1);border:1px solid rgba(252,251,247,.25);color:var(--paper);border-radius:999px;padding:.4rem .8rem;cursor:pointer}
.chip:hover{background:rgba(252,251,247,.2)}
.ob-btn{margin-top:1.6rem;background:var(--paper);color:var(--evergreen)}
.ob-timer .timer-ring .num{color:var(--paper)}
.installed{font-family:var(--display);font-size:2.1rem;font-weight:250;color:var(--teal-bright)}
.onboard-tracker{margin-top:1rem;border:1px solid rgba(252,251,247,.22);border-radius:10px;padding:.95rem;background:rgba(252,251,247,.08)}
.onboard-tracker strong{display:block;font-family:var(--display);font-size:1.05rem;color:var(--paper)}
.onboard-tracker span{display:block;color:rgba(252,251,247,.7);font-size:.88rem;margin-top:.2rem}
.onboard-dots{display:grid;grid-template-columns:repeat(7,1fr);gap:.4rem;margin-top:.75rem}
.onboard-dots i{display:flex;align-items:center;justify-content:center;aspect-ratio:1;border:1px solid rgba(252,251,247,.25);border-radius:999px;color:rgba(252,251,247,.72);font-family:var(--mono);font-size:.58rem;font-style:normal}
.onboard-dots i:first-child{background:var(--teal-bright);border-color:var(--teal-bright);color:var(--evergreen-deep);font-weight:700}
.base-hero{background:var(--black);border-radius:28px;padding:1rem;color:var(--paper);margin-top:1rem;position:relative;overflow:hidden}
.base-hero::after{content:"";position:absolute;width:130px;height:130px;border:1px solid rgba(46,156,124,.25);border-radius:50%;right:-55px;top:-55px}
.base-hero .day-label{color:var(--teal-bright)}
.base-identity{font-family:var(--hand);font-size:1.7rem;font-weight:600;line-height:1.18;margin-top:.55rem;position:relative;z-index:1}
.base-proof{position:relative;z-index:1;margin-top:.9rem;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.14);border-radius:10px;padding:.8rem;color:rgba(252,251,247,.82);font-size:.9rem}
.phase-strip{display:flex;gap:5px;margin-top:.85rem}
.phase-strip span{height:5px;flex:1;border-radius:999px;background:#D8D3C6}
.phase-strip span.on{background:var(--black)}
.tool-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:1rem}
.tool-card{border:1px solid var(--line);background:#fff;border-radius:20px;padding:.95rem;text-align:left;color:var(--ink);min-height:118px}
.tool-card strong{display:block;font-family:var(--display);font-size:1rem;line-height:1.12}
.tool-card span{display:block;color:var(--ink-soft);font-size:.76rem;line-height:1.35;margin-top:.4rem}
.tool-card i{display:inline-block;font-style:normal;font-family:var(--mono);font-size:.55rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:.55rem}
.tool-card.locked{background:var(--paper-shade)}
</style>
</head>
<body>
<div class="phone">
  <div class="onboard" id="onboard">
    <div class="ob-step active" id="ob1">
      <p class="ob-kicker">THE 1 • 60 • 7 TEST</p>
      <h1>HALO NOW</h1>
      <p class="halo-phrase"><b>H</b>appened <b>A</b>lready. <b>L</b>ive <b>O</b>n.</p>
      <p>Stop trying to become the person you want to be. Decide who you are, prove it with one action in the next 60 seconds, then live from the decision for seven days.</p>
      <div class="ob-card">
        <span class="lbl">The Card - Side One</span>
        <div class="row"><span>I am</span><input id="obIdentity" placeholder="a healthy person." maxlength="44" autocomplete="off"></div>
      </div>
      <div class="chips" aria-label="Suggestions">
        <button class="chip" data-id="a healthy person." data-proof="Walk for sixty seconds." data-min="Put on walking shoes." data-reset="Stand up and take one breath.">a healthy person.</button>
        <button class="chip" data-id="a wealth builder." data-proof="Move one dollar or review one number." data-min="Open the account." data-reset="Look at the next smallest number.">a wealth builder.</button>
        <button class="chip" data-id="a present parent." data-proof="Give ten undistracted minutes." data-min="Put the phone face down." data-reset="Make eye contact and return.">a present parent.</button>
        <button class="chip" data-id="a writer." data-proof="Write one honest sentence." data-min="Open the draft." data-reset="Write the next bad sentence.">a writer.</button>
        <button class="chip" data-id="a business owner." data-proof="Send one useful follow-up." data-min="Open the pipeline." data-reset="Name the next customer action.">a business owner.</button>
      </div>
      <div class="field-grid" aria-label="1 • 60 • 7 setup">
        <div><label for="obProof">First proof</label><input id="obProof" placeholder="One action that can begin within sixty seconds."></div>
        <div><label for="obMinimum">Hard-day minimum</label><input id="obMinimum" placeholder="The smallest version that still counts."></div>
        <div><label for="obReset">Reset rule</label><input id="obReset" placeholder="What protects the return after a slip?"></div>
        <div><label for="obReview">Review date</label><input id="obReview" placeholder="Day 90 review" value="Day 90 review"></div>
      </div>
      <p class="form-error" id="obError">Enter your identity and the action you will take now.</p>
      <button class="btn btn-primary ob-btn" onclick="obNext()">Begin 1 • 60 • 7</button>
    </div>

    <div class="ob-step" id="ob2">
      <p class="ob-kicker">60 &middot; The Proof</p>
      <h1>What would the person you have decided to be do right now?</h1>
      <p>Take one aligned action within sixty seconds. Every aligned action adds evidence. Small counts: send the message, move the money, take the walk, open the draft.</p>
      <div class="timer-wrap ob-timer">
        <div class="timer-ring">
          <svg width="150" height="150" viewBox="0 0 150 150" aria-hidden="true">
            <circle cx="75" cy="75" r="66" stroke="rgba(252,251,247,.15)" stroke-width="8" fill="none"/>
            <circle id="obRing" cx="75" cy="75" r="66" stroke="#2E9C7C" stroke-width="8" fill="none" stroke-linecap="round" stroke-dasharray="414.7" stroke-dashoffset="0"/>
          </svg>
          <div class="num" id="obNum">60</div>
        </div>
        <p class="timer-note">Action: <span id="obActionText">the first proof</span></p>
