---
import BlueprintLayout from '../../components/BlueprintLayout.astro';
import HaloAccount from '../../components/HaloAccount.astro';
---
<BlueprintLayout title="HALO Launch Dashboard" description="Staff overview of the HALO launch plan." noindex={true}>
  <section class="launch">
    <p class="label">HALO / Executive overview</p>
    <h1>HALO Launch Dashboard</h1>
    <HaloAccount />
    <p data-launch-status role="status">Sign in with a HALO launch staff account.</p>
    <div data-launch-dashboard hidden></div>
  </section>
</BlueprintLayout>
<style>
  .launch{max-width:1120px;margin:auto;padding:clamp(1rem,4vw,3rem);color:#f1f1f5;background:#17181c;border-radius:12px}
  .launch h1{margin:.5rem 0 1.5rem;color:inherit}
  .launch :global(a){color:#c9beff}
  [data-launch-dashboard]{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1rem}
  [data-launch-dashboard][hidden]{display:none}
  [data-launch-dashboard] :global(.launch-thesis){grid-column:1/-1}
  [data-launch-dashboard] :global(section){border:1px solid #3b3d48;border-radius:9px;padding:1rem;min-width:0}
  [data-launch-dashboard] :global(h2){margin:0 0 .75rem;color:inherit;font:700 1.25rem system-ui}
  [data-launch-dashboard] :global(dl){margin:0}
  [data-launch-dashboard] :global(.launch-row){display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-top:1px solid #3b3d48}
  [data-launch-dashboard] :global(dd){margin:0;text-align:right;color:#d5caff;overflow-wrap:anywhere}
  @media(max-width:650px){[data-launch-dashboard]{grid-template-columns:1fr}}
</style>
<script>
  import { supabase } from '../../scripts/halo-account';

  type Snapshot = {
    thesis: string;
    note: string;
    sections: { title: string; rows: [string, string][] }[];
  };
  const client = supabase;
  const status = document.querySelector<HTMLElement>('[data-launch-status]')!;
  const dashboard = document.querySelector<HTMLElement>('[data-launch-dashboard]')!;
  let generation = 0;

  async function load(view: number) {
    const { data: assignment, error: assignmentError } = await client!.from('halo_launch_staff')
      .select('user_id').maybeSingle();
    if (view !== generation) return;
    if (assignmentError || !assignment) {
      status.textContent = assignmentError ? 'Could not verify launch staff access.' : 'Launch staff access is required.';
      return;
    }
    const { data, error } = await client!.from('halo_launch_dashboard').select('snapshot')
      .eq('id', 'overview').maybeSingle();
    if (view !== generation) return;
    if (error || !data) {
      status.textContent = error ? 'Could not load the launch overview.' : 'The launch overview has not been loaded yet.';
      return;
    }

    const snapshot = data.snapshot as Snapshot;
    const intro = document.createElement('div');
    intro.className = 'launch-thesis';
    const thesis = document.createElement('p');
    thesis.textContent = snapshot.thesis;
    const note = document.createElement('small');
    note.textContent = snapshot.note;
    intro.append(thesis, note);
    dashboard.append(intro);
    for (const group of snapshot.sections) {
      const section = document.createElement('section');
      const title = document.createElement('h2');
      title.textContent = group.title;
      const list = document.createElement('dl');
      for (const [label, value] of group.rows) {
        const row = document.createElement('div');
        row.className = 'launch-row';
        const term = document.createElement('dt');
        term.textContent = label;
        const detail = document.createElement('dd');
        detail.textContent = value;
        row.append(term, detail);
        list.append(row);
      }
      section.append(title, list);
      dashboard.append(section);
    }
    status.textContent = 'Workbook snapshot';
    dashboard.hidden = false;
  }

  if (!client) status.textContent = 'HALO account sign-in is unavailable.';
  else client.auth.onAuthStateChange((_event, session) => {
    const view = ++generation;
    dashboard.hidden = true;
    dashboard.replaceChildren();
    status.textContent = session ? 'Checking launch staff access…' : 'Sign in with a HALO launch staff account.';
    if (session) window.setTimeout(() => { if (view === generation) void load(view); }, 0);
  });
</script>
