---
import '../../../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Install Once ZenBid Integration API Documentation" />
    <title>ZenBid Integration API | Install Once</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
      .code-font { font-family: 'JetBrains Mono', monospace; }
    </style>
  </head>
  <body class="min-h-screen bg-gray-900 text-white">
    <!-- Header -->
    <header class="bg-gray-800 border-b border-gray-700">
      <div class="max-w-6xl mx-auto px-6 py-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <h1 class="text-2xl font-bold text-cyan-glow">Install Once</h1>
            <span class="text-gray-400">ZenBid Integration API</span>
          </div>
          <nav class="flex space-x-6">
            <a href="/" class="text-cyan-glow hover:text-white transition-colors">Home</a>
            <a href="/business-dashboard" class="text-gray-400 hover:text-white transition-colors">Dashboard</a>
            <a href="/api/zenbid/" class="text-white font-medium">API Docs</a>
          </nav>
        </div>
      </div>
    </header>

    <div class="max-w-6xl mx-auto px-6 py-8">
      <!-- Introduction -->
      <div class="mb-12">
        <h2 class="text-4xl font-bold mb-4">ZenBid Integration API</h2>
        <p class="text-gray-300 text-lg mb-6">
          Complete API integration allowing AI agents to discover, negotiate, and book life transformation coaching services through the ZenBid marketplace.
        </p>
        
        <div class="bg-gradient-to-br from-cyan-600/20 to-blue-600/20 rounded-xl p-6 border border-cyan-500/30">
          <div class="flex items-start space-x-4">
            <div class="bg-cyan-500/20 p-3 rounded-lg">
              <svg class="w-8 h-8 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-2">Live Integration Status</h3>
              <p class="text-gray-300 mb-4">
                Install Once is fully integrated with ZenBid marketplace. AI agents can discover and book our transformation coaching services with dynamic pricing and real-time availability.
              </p>
              <div class="flex flex-wrap gap-3">
                <span class="px-3 py-1 bg-green-500/20 text-green-400 rounded-full text-sm">✓ Service Discovery</span>
                <span class="px-3 py-1 bg-green-500/20 text-green-400 rounded-full text-sm">✓ Dynamic Pricing</span>
                <span class="px-3 py-1 bg-green-500/20 text-green-400 rounded-full text-sm">✓ Auto Booking</span>
                <span class="px-3 py-1 bg-green-500/20 text-green-400 rounded-full text-sm">✓ Price Negotiation</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Base URL -->
      <div class="bg-gray-800 rounded-xl p-6 mb-8 border border-gray-700">
        <h3 class="text-xl font-bold text-white mb-4">Base URL</h3>
        <div class="bg-gray-900 rounded-lg p-4 code-font">
          <span class="text-cyan-glow">https://installonce.ai/api/zenbid/</span>
        </div>
        <p class="text-gray-400 text-sm mt-2">All API endpoints are prefixed with this base URL</p>
      </div>

      <!-- Quick Test -->
      <div class="bg-gradient-to-br from-purple-600/20 to-pink-600/20 rounded-xl p-6 mb-8 border border-purple-500/30">
        <h3 class="text-xl font-bold text-white mb-4">🧪 Quick Test</h3>
        <p class="text-gray-300 mb-4">Test the integration with our simulation endpoints:</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <a href="/api/zenbid/test?type=search" target="_blank" 
             class="bg-purple-600/20 hover:bg-purple-600/30 text-purple-300 hover:text-white p-4 rounded-lg transition-colors border border-purple-500/30">
            <strong>Agent Search Test</strong><br>
            <span class="text-sm">Simulate AI agent discovering services</span>
          </a>
          <a href="/api/zenbid/test?type=booking" target="_blank"
             class="bg-purple-600/20 hover:bg-purple-600/30 text-purple-300 hover:text-white p-4 rounded-lg transition-colors border border-purple-500/30">
            <strong>Booking Flow Test</strong><br>
            <span class="text-sm">Complete booking simulation</span>
          </a>
        </div>
      </div>

      <!-- API Endpoints -->
      <div class="space-y-8">
        
        <!-- Business Registration -->
        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
          <h3 class="text-2xl font-bold text-white mb-4">📋 Business Registration</h3>
          
          <div class="mb-6">
            <div class="flex items-center space-x-3 mb-2">
              <span class="bg-green-500 text-white px-3 py-1 rounded text-sm font-medium">POST</span>
              <span class="code-font text-gray-300">/business-register</span>
            </div>
            <p class="text-gray-400">Register Install Once as a ZenBid marketplace business</p>
          </div>

          <div class="bg-gray-900 rounded-lg p-4 mb-4">
            <h4 class="text-white font-medium mb-2">Request Body:</h4>
            <pre class="code-font text-sm text-gray-300 whitespace-pre-wrap">{
  "zenbidApiKey": "your_api_key_here"
}</pre>
          </div>

          <div class="bg-gray-900 rounded-lg p-4">
            <h4 class="text-white font-medium mb-2">Response:</h4>
            <pre class="code-font text-sm text-gray-300 whitespace-pre-wrap">{
  "success": true,
  "data": {
    "business": {
      "businessId": "installonce_ai",
      "businessName": "Install Once - Life Transformation Coaching",
      "status": "active",
      "integrationEndpoints": {
        "servicesUrl": "https://installonce.ai/api/zenbid/services",
        "bookingsUrl": "https://installonce.ai/api/zenbid/bookings"
      }
    }
  }
}</pre>
          </div>
        </div>

        <!-- Service Discovery -->
        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
          <h3 class="text-2xl font-bold text-white mb-4">🔍 Service Discovery</h3>
          
          <div class="mb-6">
            <div class="flex items-center space-x-3 mb-2">
              <span class="bg-blue-500 text-white px-3 py-1 rounded text-sm font-medium">GET</span>
              <span class="code-font text-gray-300">/services</span>
            </div>
            <p class="text-gray-400">Discover available coaching services with dynamic pricing</p>
          </div>

          <div class="bg-gray-900 rounded-lg p-4 mb-4">
            <h4 class="text-white font-medium mb-2">Query Parameters:</h4>
            <div class="code-font text-sm text-gray-300 space-y-1">
              <div><span class="text-cyan-400">category</span> - Service category (transformation, diagnostic, intensive)</div>
              <div><span class="text-cyan-400">maxPrice</span> - Maximum price filter</div>
              <div><span class="text-cyan-400">date</span> - Requested date (YYYY-MM-DD)</div>
              <div><span class="text-cyan-400">timeSlot</span> - Preferred time (HH:MM)</div>
            </div>
          </div>

          <div class="bg-gray-900 rounded-lg p-4">
            <h4 class="text-white font-medium mb-2">Example Response:</h4>
            <pre class="code-font text-sm text-gray-300 whitespace-pre-wrap overflow-x-auto">{
  "success": true,
  "services": [
    {
      "id": "identity_installation",
      "name": "Identity Installation Session",
      "description": "Install new identity, end behavior negotiations",
      "duration": 90,
      "pricing": {
        "basePrice": 150,
        "currentPrice": 120,
        "appliedRules": ["Weekday Special: 20% off Monday & Tuesday"],
        "savings": 30
      },
      "availability": {
        "nextAvailable": "2026-04-29T14:00:00Z",
        "totalSlots": 3
      }
    }
  ]
}</pre>
          </div>
        </div>

        <!-- Booking -->
        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
          <h3 class="text-2xl font-bold text-white mb-4">📅 Booking</h3>
          
          <div class="mb-6">
            <div class="flex items-center space-x-3 mb-2">
              <span class="bg-green-500 text-white px-3 py-1 rounded text-sm font-medium">POST</span>
              <span class="code-font text-gray-300">/bookings</span>
            </div>
            <p class="text-gray-400">Book a coaching session with automatic pricing negotiation</p>
          </div>

          <div class="bg-gray-900 rounded-lg p-4 mb-4">
            <h4 class="text-white font-medium mb-2">Request Body:</h4>
            <pre class="code-font text-sm text-gray-300 whitespace-pre-wrap">{
  "serviceId": "identity_installation",
  "requestedDate": "2026-04-29",
  "requestedTime": "14:00",
  "customerInfo": {
    "name": "Sarah M.",
    "email": "sarah.m@example.com",
    "agentId": "openai_gpt4_agent"
  },
  "pricing": {
    "offeredPrice": 100,
    "currency": "USD"
  },
  "requirements": "Help with confidence and self-image"
}</pre>
          </div>

          <div class="bg-gray-900 rounded-lg p-4">
            <h4 class="text-white font-medium mb-2">Response:</h4>
            <pre class="code-font text-sm text-gray-300 whitespace-pre-wrap overflow-x-auto">{
  "success": true,
  "booking": {
    "bookingId": "IO_1730160000_ABC123",
    "status": "confirmed",
    "finalPrice": 110,
    "scheduledDateTime": "2026-04-29T14:00:00Z",
    "confirmationCode": "II2914",
    "nextSteps": [
      "Check email for confirmation",
      "Payment processed 24h before session",
      "Zoom link provided in confirmation"
    ]
  }
}</pre>
          </div>
        </div>

        <!-- Availability -->
        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
          <h3 class="text-2xl font-bold text-white mb-4">📆 Availability</h3>
          
          <div class="mb-6">
            <div class="flex items-center space-x-3 mb-2">
              <span class="bg-blue-500 text-white px-3 py-1 rounded text-sm font-medium">GET</span>
              <span class="code-font text-gray-300">/availability</span>
            </div>
            <p class="text-gray-400">Check available time slots with dynamic pricing</p>
          </div>

          <div class="bg-gray-900 rounded-lg p-4 mb-4">
            <h4 class="text-white font-medium mb-2">Query Parameters:</h4>
            <div class="code-font text-sm text-gray-300 space-y-1">
              <div><span class="text-cyan-400">date</span> - Specific date or start date</div>
              <div><span class="text-cyan-400">endDate</span> - End date for range query</div>
              <div><span class="text-cyan-400">serviceId</span> - Filter by service type</div>
              <div><span class="text-cyan-400">timeStart/timeEnd</span> - Time range filter</div>
            </div>
          </div>

          <div class="bg-gray-900 rounded-lg p-4">
            <h4 class="text-white font-medium mb-2">Response Structure:</h4>
            <pre class="code-font text-sm text-gray-300 whitespace-pre-wrap">{
  "availability": [
    {
      "date": "2026-04-29",
      "dayOfWeek": "Tuesday",
      "slots": [
        {
          "startTime": "2026-04-29T10:00:00Z",
          "endTime": "2026-04-29T11:30:00Z",
          "available": true,
          "price": 120,
          "appliedRules": ["Weekday Special: 20% off"]
        }
      ],
      "totalAvailable": 4
    }
  ]
}</pre>
          </div>
        </div>

        <!-- Webhooks -->
        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
          <h3 class="text-2xl font-bold text-white mb-4">🔗 Webhooks</h3>
          
          <div class="mb-6">
            <div class="flex items-center space-x-3 mb-2">
              <span class="bg-purple-500 text-white px-3 py-1 rounded text-sm font-medium">POST</span>
              <span class="code-font text-gray-300">/webhook</span>
            </div>
            <p class="text-gray-400">Receive notifications about booking events from ZenBid</p>
          </div>

          <div class="bg-gray-900 rounded-lg p-4">
            <h4 class="text-white font-medium mb-2">Supported Events:</h4>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2 code-font text-sm text-gray-300">
              <div>• booking.created</div>
              <div>• booking.confirmed</div>
              <div>• booking.cancelled</div>
              <div>• booking.rescheduled</div>
              <div>• payment.completed</div>
              <div>• review.created</div>
            </div>
          </div>
        </div>

      </div>

      <!-- Dynamic Pricing Rules -->
      <div class="bg-gradient-to-br from-orange-600/20 to-red-600/20 rounded-xl p-6 mt-8 border border-orange-500/30">
        <h3 class="text-2xl font-bold text-white mb-4">💰 Dynamic Pricing Rules</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h4 class="font-bold text-green-400 mb-3">Discount Rules</h4>
            <div class="space-y-2 text-gray-300 text-sm">
              <div>• <strong>Monday/Tuesday:</strong> 20% off weekday sessions</div>
              <div>• <strong>Early Morning:</strong> 15% off 8-10am slots</div>
              <div>• <strong>Same-Day:</strong> 25% off last-minute bookings</div>
            </div>
          </div>
          <div>
            <h4 class="font-bold text-orange-400 mb-3">Premium Rules</h4>
            <div class="space-y-2 text-gray-300 text-sm">
              <div>• <strong>Weekends:</strong> +20% for high-demand times</div>
              <div>• <strong>Peak Hours:</strong> +15% for 5-7pm slots</div>
              <div>• <strong>Holiday Premium:</strong> Special occasion rates</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Integration Status -->
      <div class="bg-gray-800 rounded-xl p-6 mt-8 border border-gray-700">
        <h3 class="text-xl font-bold text-white mb-4">🔗 Integration Health</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="text-center">
            <div class="text-2xl font-bold text-green-400">✓</div>
            <div class="text-sm text-gray-400">Service Discovery</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-green-400">✓</div>
            <div class="text-sm text-gray-400">Booking System</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-green-400">✓</div>
            <div class="text-sm text-gray-400">Dynamic Pricing</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-green-400">✓</div>
            <div class="text-sm text-gray-400">Webhook Events</div>
          </div>
        </div>
      </div>

    </div>
  </body>
</html>