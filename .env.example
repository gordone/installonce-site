# Optional, public PostHog Cloud capture settings. Usage analytics requires browser opt-in.
PUBLIC_POSTHOG_REGION=us
PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
PUBLIC_POSTHOG_HOST=your_posthog_host_here
