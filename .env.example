# Resend API Configuration
RESEND_API_KEY=your_resend_api_key_here

# Email Configuration
FROM_EMAIL=noreply@installonce.ai
NOTIFICATION_EMAIL=gordon@yourdomain.com

# Optional, public PostHog Cloud capture settings. Usage analytics requires browser opt-in.
PUBLIC_POSTHOG_REGION=us
PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
PUBLIC_POSTHOG_HOST=your_posthog_host_here


# Existing public Supabase project settings (never put service_role/private keys here).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Native My HALO rollout: leave off until the reviewed backend and Auth redirect are ready.
PUBLIC_HALO_INTELLIGENCE_ENABLED=0
PUBLIC_HALO_INTELLIGENCE_API_URL=
